<div data-pixel-art-converter-widget class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-sm">
  <div class="grid gap-8 lg:grid-cols-2">
    <!-- Controls -->
    <div class="min-w-0 space-y-6">
      <section>
        <h4 class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">1. Image</h4>
        <label data-dropzone class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-gray-300 px-4 py-8 text-center transition hover:border-emerald-400 hover:bg-emerald-50 focus-within:ring-2 focus-within:ring-emerald-500">
          <svg class="h-8 w-8 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 18a4 4 0 01-.5-7.97A5.5 5.5 0 0117 8.5 4.5 4.5 0 0117.5 18H7z"/><path d="M12 12v6 M9.5 14.5L12 12l2.5 2.5"/></svg>
          <span class="text-sm font-medium text-gray-700">Drop an image here or click to choose one</span>
          <span class="text-xs text-gray-400">JPG, PNG or WebP. It never leaves your device.</span>
          <input data-file type="file" accept="image/*" class="sr-only" />
        </label>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <button type="button" data-sample class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 transition hover:bg-gray-50">Try a sample</button>
          <span data-filename class="min-w-0 truncate text-xs text-gray-400"></span>
        </div>
        <p data-error class="mt-2 hidden text-sm text-red-600" role="status" aria-live="polite"></p>
      </section>

      <section>
        <h4 class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">2. Pixel size</h4>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="flex justify-between text-sm text-gray-600"><span>Longest side</span><span data-val-size class="tabular-nums text-gray-400"></span></span>
            <input data-size type="range" min="16" max="320" step="2" value="96" class="mt-1 w-full accent-emerald-600" />
          </label>
          <label class="block">
            <span class="text-sm text-gray-600">Downscale method</span>
            <select data-method class="mt-1 w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500">
              <option value="average" selected>Average (smooth)</option>
              <option value="nearest">Nearest (crisp)</option>
            </select>
          </label>
        </div>
      </section>

      <section>
        <h4 class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">3. Palette</h4>
        <div data-palettes class="grid grid-cols-2 gap-2 sm:grid-cols-3"></div>
        <label data-auto-row class="mt-4 block">
          <span class="flex justify-between text-sm text-gray-600"><span>Colours in the auto palette</span><span data-val-colors class="tabular-nums text-gray-400"></span></span>
          <input data-colors type="range" min="2" max="32" step="1" value="8" class="mt-1 w-full accent-emerald-600" />
        </label>
      </section>

      <section>
        <h4 class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">4. Dithering</h4>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="text-sm text-gray-600">Method</span>
            <select data-dither class="mt-1 w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500">
              <option value="none">None (flat colour)</option>
              <option value="bayer4" selected>Bayer 4x4 (ordered)</option>
              <option value="bayer8">Bayer 8x8 (ordered)</option>
              <option value="fs">Floyd-Steinberg (error diffusion)</option>
              <option value="atkinson">Atkinson (error diffusion)</option>
            </select>
          </label>
          <label class="block">
            <span class="flex justify-between text-sm text-gray-600"><span>Strength</span><span data-val-strength class="tabular-nums text-gray-400"></span></span>
            <input data-strength type="range" min="0" max="1" step="0.05" value="0.6" class="mt-3 w-full accent-emerald-600" />
          </label>
        </div>
      </section>

      <section>
        <h4 class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">5. Tone</h4>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="flex justify-between text-sm text-gray-600"><span>Brightness</span><span data-val-brightness class="tabular-nums text-gray-400"></span></span>
            <input data-brightness type="range" min="-50" max="50" step="1" value="0" class="mt-1 w-full accent-emerald-600" />
          </label>
          <label class="block">
            <span class="flex justify-between text-sm text-gray-600"><span>Contrast</span><span data-val-contrast class="tabular-nums text-gray-400"></span></span>
            <input data-contrast type="range" min="-50" max="50" step="1" value="0" class="mt-1 w-full accent-emerald-600" />
          </label>
          <label class="block">
            <span class="flex justify-between text-sm text-gray-600"><span>Saturation</span><span data-val-saturation class="tabular-nums text-gray-400"></span></span>
            <input data-saturation type="range" min="-100" max="100" step="1" value="0" class="mt-1 w-full accent-emerald-600" />
          </label>
          <label class="flex items-center gap-2 self-end pb-1 text-sm text-gray-600">
            <input data-alpha type="checkbox" checked class="h-4 w-4 rounded border-gray-300 accent-emerald-600" />
            <span>Keep transparent areas</span>
          </label>
        </div>
      </section>
    </div>

    <!-- Preview -->
    <div class="min-w-0 lg:sticky lg:top-6 lg:self-start">
      <h4 class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">Preview</h4>
      <div class="relative w-full overflow-hidden rounded-xl border border-gray-200 bg-[repeating-conic-gradient(#e5e7eb_0%_25%,#f9fafb_0%_50%)] bg-[length:16px_16px]">
        <canvas data-preview width="320" height="240" role="img" aria-label="Pixel art preview" class="hidden h-auto w-full"></canvas>
        <div data-placeholder class="flex min-h-[260px] items-center justify-center p-6 text-center text-sm text-gray-400">Add an image or press Try a sample to see the pixel art here.</div>
      </div>
      <div data-swatches class="mt-3 flex flex-wrap gap-1.5"></div>
      <p data-info class="mt-3 text-xs text-gray-500"></p>

      <div class="mt-4 grid gap-3 sm:grid-cols-2 sm:items-end">
        <label class="block">
          <span class="text-sm text-gray-600">Export scale</span>
          <select data-export class="mt-1 w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500">
            <option value="1">1x (actual pixels)</option>
            <option value="2">2x</option>
            <option value="4">4x</option>
            <option value="8" selected>8x</option>
            <option value="16">16x</option>
          </select>
        </label>
        <button type="button" data-download disabled class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11 M7.5 11L12 15.5 16.5 11 M5 20h14"/></svg>
          Download PNG
        </button>
      </div>
      <div class="mt-3 flex">
        <button type="button" data-reset class="ml-auto text-xs text-gray-400 hover:text-red-600">Reset settings</button>
      </div>
    </div>
  </div>
</div>

<script>
  type PresetDef = { id: string; name: string; colors: string[] };

  const PRESETS: PresetDef[] = [
    { id: "auto", name: "Auto from image", colors: [] },
    { id: "gameboy", name: "Game Boy (4)", colors: ["#0f380f", "#306230", "#8bac0f", "#9bbc0f"] },
    { id: "mono", name: "1-bit black and white", colors: ["#000000", "#ffffff"] },
    { id: "grey4", name: "4-shade grey", colors: ["#000000", "#555555", "#aaaaaa", "#ffffff"] },
    {
      id: "ega",
      name: "EGA (16)",
      colors: ["#000000", "#0000aa", "#00aa00", "#00aaaa", "#aa0000", "#aa00aa", "#aa5500", "#aaaaaa", "#555555", "#5555ff", "#55ff55", "#55ffff", "#ff5555", "#ff55ff", "#ffff55", "#ffffff"],
    },
    {
      id: "c64",
      name: "C64 (16)",
      colors: ["#000000", "#626262", "#898989", "#adadad", "#ffffff", "#9f4e44", "#cb7e75", "#6d5412", "#a1683c", "#c9d487", "#9ae29b", "#5cab5e", "#6abfc6", "#887ecb", "#50459b", "#a057a3"],
    },
    { id: "neon-night", name: "Neon night (8)", colors: ["#0a0820", "#1c1250", "#3b1f7a", "#7b2fd0", "#ff2d95", "#00d9ff", "#7dffd8", "#f3eaff"] },
    { id: "sunset-city", name: "Sunset city (10)", colors: ["#1a1033", "#3a1b5c", "#2c3c78", "#6e2a7f", "#5a7fc4", "#b83a7b", "#f2566b", "#ff8c5a", "#ffc46b", "#fff0cf"] },
    { id: "cyber-street", name: "Cyber street (10)", colors: ["#04060c", "#0e1a2b", "#17304c", "#3a3a52", "#1f6d8c", "#00d0ff", "#ff38e6", "#fcee0a", "#6bff7c", "#dfeaff"] },
  ];

  const ACTIVE = ["border-emerald-500", "bg-emerald-50", "text-emerald-700", "ring-1", "ring-emerald-500"];
  const IDLE = ["border-gray-200", "bg-white", "text-gray-600"];

  const DEFAULTS = {
    size: 96,
    method: "average",
    preset: "auto",
    colors: 8,
    dither: "bayer4",
    strength: 0.6,
    brightness: 0,
    contrast: 0,
    saturation: 0,
    keepAlpha: true,
    exportScale: 8,
  };

  const FS_KERNEL: number[][] = [
    [1, 0, 7 / 16],
    [-1, 1, 3 / 16],
    [0, 1, 5 / 16],
    [1, 1, 1 / 16],
  ];
  const ATKINSON_KERNEL: number[][] = [
    [1, 0, 1 / 8],
    [2, 0, 1 / 8],
    [-1, 1, 1 / 8],
    [0, 1, 1 / 8],
    [1, 1, 1 / 8],
    [0, 2, 1 / 8],
  ];

  function clamp(v: number, lo: number, hi: number): number {
    return Math.min(hi, Math.max(lo, v));
  }

  function hexToRgb(hex: string): number[] {
    const n = parseInt(hex.slice(1), 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }

  // "Redmean" weighted distance: close to perceptual for sRGB and cheap enough for per-pixel use.
  function nearestIdx(r: number, g: number, b: number, pal: number[][]): number {
    let best = Infinity;
    let pick = 0;
    for (let k = 0; k < pal.length; k++) {
      const p = pal[k];
      const rm = (r + p[0]) / 2;
      const dr = r - p[0];
      const dg = g - p[1];
      const db = b - p[2];
      const d = (2 + rm / 256) * dr * dr + 4 * dg * dg + (2 + (255 - rm) / 256) * db * db;
      if (d < best) {
        best = d;
        pick = k;
      }
    }
    return pick;
  }

  function bayerMatrix(n: number): number[] {
    let m: number[] = [0];
    let size = 1;
    while (size < n) {
      const ns = size * 2;
      const nm: number[] = new Array(ns * ns);
      for (let y = 0; y < size; y++) {
        for (let x = 0; x < size; x++) {
          const v = m[y * size + x] * 4;
          nm[y * ns + x] = v;
          nm[y * ns + x + size] = v + 2;
          nm[(y + size) * ns + x] = v + 3;
          nm[(y + size) * ns + x + size] = v + 1;
        }
      }
      m = nm;
      size = ns;
    }
    return m.map((v) => (v + 0.5) / (n * n) - 0.5);
  }

  // Median cut: repeatedly split the box with the widest colour range at its median.
  function medianCut(rgb: ArrayLike<number>, count: number, k: number): number[][] {
    if (count === 0) return [[0, 0, 0]];
    let boxes: number[][] = [Array.from({ length: count }, (_, i) => i)];
    while (boxes.length < k) {
      let bi = -1;
      let bRange = 0;
      let bCh = 0;
      for (let i = 0; i < boxes.length; i++) {
        const box = boxes[i];
        if (box.length < 2) continue;
        const mn = [255, 255, 255];
        const mx = [0, 0, 0];
        for (const p of box) {
          for (let c = 0; c < 3; c++) {
            const v = rgb[p * 3 + c];
            if (v < mn[c]) mn[c] = v;
            if (v > mx[c]) mx[c] = v;
          }
        }
        for (let c = 0; c < 3; c++) {
          const r = mx[c] - mn[c];
          if (r > bRange) {
            bRange = r;
            bi = i;
            bCh = c;
          }
        }
      }
      if (bi < 0) break;
      const box = boxes[bi];
      box.sort((a, b) => rgb[a * 3 + bCh] - rgb[b * 3 + bCh]);
      const mid = box.length >> 1;
      boxes.splice(bi, 1, box.slice(0, mid), box.slice(mid));
    }
    return boxes.map((box) => {
      let r = 0;
      let g = 0;
      let b = 0;
      for (const p of box) {
        r += rgb[p * 3];
        g += rgb[p * 3 + 1];
        b += rgb[p * 3 + 2];
      }
      const n = box.length || 1;
      return [Math.round(r / n), Math.round(g / n), Math.round(b / n)];
    });
  }

  function quantize(
    rgba: ArrayLike<number>,
    w: number,
    h: number,
    pal: number[][],
    dither: string,
    strength: number,
  ): { out: Uint8ClampedArray; used: number } {
    const n = w * h;
    const out = new Uint8ClampedArray(n * 4);
    const used = new Set<number>();
    const put = (i: number, idx: number) => {
      out[i * 4] = pal[idx][0];
      out[i * 4 + 1] = pal[idx][1];
      out[i * 4 + 2] = pal[idx][2];
      out[i * 4 + 3] = 255;
      used.add(idx);
    };

    if (dither === "bayer4" || dither === "bayer8") {
      const bn = dither === "bayer4" ? 4 : 8;
      const m = bayerMatrix(bn);
      const amp = ((strength * 255) / Math.cbrt(pal.length)) * 0.8;
      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          const i = y * w + x;
          if (rgba[i * 4 + 3] < 128) continue;
          const bias = m[(y % bn) * bn + (x % bn)] * amp;
          const r = clamp(rgba[i * 4] + bias, 0, 255);
          const g = clamp(rgba[i * 4 + 1] + bias, 0, 255);
          const b = clamp(rgba[i * 4 + 2] + bias, 0, 255);
          put(i, nearestIdx(r, g, b, pal));
        }
      }
      return { out, used: used.size };
    }

    const kernel = dither === "fs" ? FS_KERNEL : dither === "atkinson" ? ATKINSON_KERNEL : null;
    const buf = new Float32Array(n * 3);
    for (let i = 0; i < n; i++) {
      buf[i * 3] = rgba[i * 4];
      buf[i * 3 + 1] = rgba[i * 4 + 1];
      buf[i * 3 + 2] = rgba[i * 4 + 2];
    }
    for (let y = 0; y < h; y++) {
      for (let x = 0; x < w; x++) {
        const i = y * w + x;
        if (rgba[i * 4 + 3] < 128) continue;
        const r = clamp(buf[i * 3], 0, 255);
        const g = clamp(buf[i * 3 + 1], 0, 255);
        const b = clamp(buf[i * 3 + 2], 0, 255);
        const idx = nearestIdx(r, g, b, pal);
        put(i, idx);
        if (!kernel || strength <= 0) continue;
        const er = (r - pal[idx][0]) * strength;
        const eg = (g - pal[idx][1]) * strength;
        const eb = (b - pal[idx][2]) * strength;
        for (const kk of kernel) {
          const nx = x + kk[0];
          const ny = y + kk[1];
          if (nx < 0 || nx >= w || ny >= h) continue;
          const j = ny * w + nx;
          if (rgba[j * 4 + 3] < 128) continue;
          buf[j * 3] += er * kk[2];
          buf[j * 3 + 1] += eg * kk[2];
          buf[j * 3 + 2] += eb * kk[2];
        }
      }
    }
    return { out, used: used.size };
  }

  function makeCanvas(w: number, h: number): HTMLCanvasElement {
    const c = document.createElement("canvas");
    c.width = Math.max(1, Math.round(w));
    c.height = Math.max(1, Math.round(h));
    return c;
  }

  function smooth(ctx: CanvasRenderingContext2D, on: boolean) {
    ctx.imageSmoothingEnabled = on;
    if (on) ctx.imageSmoothingQuality = "high";
  }

  // Shrink in halving steps so every source pixel contributes (a single big drawImage skips pixels).
  function shrinkAverage(src: CanvasImageSource, sw: number, sh: number, dw: number, dh: number): HTMLCanvasElement {
    let cw = Math.max(dw, Math.round(sw));
    let ch = Math.max(dh, Math.round(sh));
    let cur = makeCanvas(cw, ch);
    let ctx = cur.getContext("2d")!;
    smooth(ctx, true);
    ctx.drawImage(src, 0, 0, sw, sh, 0, 0, cw, ch);
    while (cw > dw * 2 || ch > dh * 2) {
      const nw = Math.max(dw, Math.floor(cw / 2));
      const nh = Math.max(dh, Math.floor(ch / 2));
      const next = makeCanvas(nw, nh);
      const nctx = next.getContext("2d")!;
      smooth(nctx, true);
      nctx.drawImage(cur, 0, 0, cw, ch, 0, 0, nw, nh);
      cur = next;
      cw = nw;
      ch = nh;
    }
    if (cw !== dw || ch !== dh) {
      const last = makeCanvas(dw, dh);
      const lctx = last.getContext("2d")!;
      smooth(lctx, true);
      lctx.drawImage(cur, 0, 0, cw, ch, 0, 0, dw, dh);
      cur = last;
    }
    return cur;
  }

  function shrinkNearest(src: CanvasImageSource, sw: number, sh: number, dw: number, dh: number): HTMLCanvasElement {
    const c = makeCanvas(dw, dh);
    const ctx = c.getContext("2d")!;
    smooth(ctx, false);
    ctx.drawImage(src, 0, 0, sw, sh, 0, 0, dw, dh);
    return c;
  }

  function drawScaled(target: HTMLCanvasElement, small: HTMLCanvasElement, scale: number) {
    target.width = small.width * scale;
    target.height = small.height * scale;
    const ctx = target.getContext("2d")!;
    ctx.imageSmoothingEnabled = false;
    ctx.clearRect(0, 0, target.width, target.height);
    ctx.drawImage(small, 0, 0, target.width, target.height);
  }

  function drawSample(): HTMLCanvasElement {
    const c = makeCanvas(640, 420);
    const g = c.getContext("2d")!;
    const sky = g.createLinearGradient(0, 0, 0, 260);
    sky.addColorStop(0, "#1b1b4b");
    sky.addColorStop(0.55, "#a2386f");
    sky.addColorStop(1, "#ffb067");
    g.fillStyle = sky;
    g.fillRect(0, 0, 640, 420);
    g.fillStyle = "#ffffff";
    for (let i = 0; i < 40; i++) g.fillRect((i * 97) % 640, (i * 53) % 110, 2, 2);
    const sun = g.createRadialGradient(430, 215, 8, 430, 215, 90);
    sun.addColorStop(0, "#fff6c9");
    sun.addColorStop(0.35, "#ffd36b");
    sun.addColorStop(1, "rgba(255,150,80,0)");
    g.fillStyle = sun;
    g.fillRect(300, 100, 260, 220);
    g.fillStyle = "#3a2056";
    g.beginPath();
    g.moveTo(0, 270);
    g.lineTo(90, 190);
    g.lineTo(170, 250);
    g.lineTo(260, 170);
    g.lineTo(360, 260);
    g.lineTo(470, 200);
    g.lineTo(560, 255);
    g.lineTo(640, 215);
    g.lineTo(640, 290);
    g.lineTo(0, 290);
    g.closePath();
    g.fill();
    const sea = g.createLinearGradient(0, 290, 0, 420);
    sea.addColorStop(0, "#c2527a");
    sea.addColorStop(1, "#1d2b64");
    g.fillStyle = sea;
    g.fillRect(0, 290, 640, 130);
    g.fillStyle = "rgba(255,225,150,0.55)";
    for (let i = 0; i < 9; i++) g.fillRect(400 + (i % 2) * 14 - i * 2, 300 + i * 12, 70 - i * 5, 4);
    return c;
  }

  function initPixelArtConverter(root: HTMLElement) {
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

    const dropzone = q<HTMLElement>("[data-dropzone]");
    const fileInput = q<HTMLInputElement>("[data-file]");
    const sampleBtn = q<HTMLButtonElement>("[data-sample]");
    const filenameEl = q<HTMLElement>("[data-filename]");
    const errorEl = q<HTMLElement>("[data-error]");
    const sizeIn = q<HTMLInputElement>("[data-size]");
    const methodSel = q<HTMLSelectElement>("[data-method]");
    const palettesEl = q<HTMLElement>("[data-palettes]");
    const autoRow = q<HTMLElement>("[data-auto-row]");
    const colorsIn = q<HTMLInputElement>("[data-colors]");
    const ditherSel = q<HTMLSelectElement>("[data-dither]");
    const strengthIn = q<HTMLInputElement>("[data-strength]");
    const brightIn = q<HTMLInputElement>("[data-brightness]");
    const contrastIn = q<HTMLInputElement>("[data-contrast]");
    const satIn = q<HTMLInputElement>("[data-saturation]");
    const alphaIn = q<HTMLInputElement>("[data-alpha]");
    const exportSel = q<HTMLSelectElement>("[data-export]");
    const canvas = q<HTMLCanvasElement>("[data-preview]");
    const placeholder = q<HTMLElement>("[data-placeholder]");
    const swatchesEl = q<HTMLElement>("[data-swatches]");
    const infoEl = q<HTMLElement>("[data-info]");
    const downloadBtn = q<HTMLButtonElement>("[data-download]");
    const resetBtn = q<HTMLButtonElement>("[data-reset]");

    const valLabels: Record<string, HTMLElement> = {
      size: q<HTMLElement>("[data-val-size]"),
      colors: q<HTMLElement>("[data-val-colors]"),
      strength: q<HTMLElement>("[data-val-strength]"),
      brightness: q<HTMLElement>("[data-val-brightness]"),
      contrast: q<HTMLElement>("[data-val-contrast]"),
      saturation: q<HTMLElement>("[data-val-saturation]"),
    };

    const state = { ...DEFAULTS };
    let src: HTMLCanvasElement | null = null;
    let lastPx: HTMLCanvasElement | null = null;
    let raf = 0;

    const presetBtns: HTMLButtonElement[] = [];
    PRESETS.forEach((p) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.dataset.value = p.id;
      btn.className = "rounded-lg border px-3 py-2 text-left text-sm font-medium transition hover:border-gray-300";
      const name = document.createElement("span");
      name.className = "block";
      name.textContent = p.name;
      btn.appendChild(name);
      const strip = document.createElement("span");
      strip.className = "mt-1.5 flex h-2 overflow-hidden rounded-sm bg-gray-200";
      p.colors.forEach((hex) => {
        const sw = document.createElement("span");
        sw.className = "h-full flex-1";
        sw.style.backgroundColor = hex;
        strip.appendChild(sw);
      });
      if (p.id === "auto") strip.style.backgroundImage = "linear-gradient(90deg,#ef4444,#f59e0b,#10b981,#3b82f6,#8b5cf6)";
      btn.appendChild(strip);
      btn.addEventListener("click", () => {
        state.preset = p.id;
        syncControls();
        schedule();
      });
      palettesEl.appendChild(btn);
      presetBtns.push(btn);
    });

    function setActive(btn: HTMLElement, on: boolean) {
      ACTIVE.forEach((c) => btn.classList.toggle(c, on));
      IDLE.forEach((c) => btn.classList.toggle(c, !on));
      btn.setAttribute("aria-pressed", on ? "true" : "false");
    }

    function showError(msg: string) {
      errorEl.textContent = msg;
      errorEl.classList.toggle("hidden", !msg);
    }

    function schedule() {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(render);
    }

    function syncControls() {
      presetBtns.forEach((b) => setActive(b, b.dataset.value === state.preset));
      autoRow.classList.toggle("hidden", state.preset !== "auto");
      sizeIn.value = String(state.size);
      methodSel.value = state.method;
      colorsIn.value = String(state.colors);
      ditherSel.value = state.dither;
      strengthIn.value = String(state.strength);
      strengthIn.disabled = state.dither === "none";
      strengthIn.classList.toggle("opacity-40", state.dither === "none");
      brightIn.value = String(state.brightness);
      contrastIn.value = String(state.contrast);
      satIn.value = String(state.saturation);
      alphaIn.checked = state.keepAlpha;
      exportSel.value = String(state.exportScale);
      valLabels.size.textContent = state.size + " px";
      valLabels.colors.textContent = String(state.colors);
      valLabels.strength.textContent = Math.round(state.strength * 100) + "%";
      valLabels.brightness.textContent = String(state.brightness);
      valLabels.contrast.textContent = String(state.contrast);
      valLabels.saturation.textContent = String(state.saturation);
    }

    function showSwatches(pal: number[][]) {
      swatchesEl.textContent = "";
      const order = pal
        .map((c, i) => ({ c, i, l: 0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2] }))
        .sort((a, b) => a.l - b.l);
      order.forEach(({ c }) => {
        const sw = document.createElement("span");
        sw.className = "h-6 w-6 rounded border border-gray-200";
        const hex = "#" + c.map((v) => v.toString(16).padStart(2, "0")).join("");
        sw.style.backgroundColor = hex;
        sw.title = hex;
        swatchesEl.appendChild(sw);
      });
    }

    function render() {
      if (!src) {
        placeholder.classList.remove("hidden");
        canvas.classList.add("hidden");
        downloadBtn.disabled = true;
        swatchesEl.textContent = "";
        infoEl.textContent = "";
        lastPx = null;
        return;
      }
      placeholder.classList.add("hidden");
      canvas.classList.remove("hidden");
      downloadBtn.disabled = false;

      const sw = src.width;
      const sh = src.height;
      const L = state.size;
      const W = sw >= sh ? L : Math.max(1, Math.round((L * sw) / sh));
      const H = sw >= sh ? Math.max(1, Math.round((L * sh) / sw)) : L;

      const small = state.method === "nearest" ? shrinkNearest(src, sw, sh, W, H) : shrinkAverage(src, sw, sh, W, H);
      const raw = small.getContext("2d")!.getImageData(0, 0, W, H).data;

      const contrastF = 1 + state.contrast / 100;
      const bOff = state.brightness * 2.55;
      const satF = 1 + state.saturation / 100;
      const rgba = new Uint8ClampedArray(W * H * 4);
      const opaque: number[] = [];
      for (let i = 0; i < W * H; i++) {
        const r = raw[i * 4];
        const g = raw[i * 4 + 1];
        const b = raw[i * 4 + 2];
        const a = state.keepAlpha ? raw[i * 4 + 3] : 255;
        const gray = 0.299 * r + 0.587 * g + 0.114 * b;
        const ch = [r, g, b].map((v) => clamp(((gray + (v - gray) * satF) - 128) * contrastF + 128 + bOff, 0, 255));
        rgba[i * 4] = ch[0];
        rgba[i * 4 + 1] = ch[1];
        rgba[i * 4 + 2] = ch[2];
        rgba[i * 4 + 3] = a;
        if (a >= 128) opaque.push(ch[0], ch[1], ch[2]);
      }

      let pal: number[][];
      if (state.preset === "auto") {
        pal = medianCut(opaque, opaque.length / 3, state.colors);
      } else {
        const def = PRESETS.find((p) => p.id === state.preset) || PRESETS[1];
        pal = def.colors.map(hexToRgb);
      }

      const res = quantize(rgba, W, H, pal, state.dither, state.strength);
      const px = makeCanvas(W, H);
      const imgData = new ImageData(W, H);
      imgData.data.set(res.out);
      px.getContext("2d")!.putImageData(imgData, 0, 0);
      lastPx = px;

      drawScaled(canvas, px, Math.max(1, Math.ceil(640 / Math.max(W, H))));
      showSwatches(pal);

      const es = state.exportScale;
      infoEl.textContent = W + " x " + H + " px, " + res.used + " of " + pal.length + " palette colours used. Export: " + W * es + " x " + H * es + " px (" + es + "x).";
    }

    function setSource(img: CanvasImageSource, w: number, h: number) {
      if (!w || !h) {
        showError("That image has no readable size. Try a JPG or PNG.");
        return;
      }
      const k = Math.min(1, 1600 / Math.max(w, h));
      const dw = Math.max(1, Math.round(w * k));
      const dh = Math.max(1, Math.round(h * k));
      src = shrinkAverage(img, w, h, dw, dh);
      showError("");
      schedule();
    }

    function loadFile(file: File) {
      showError("");
      if (!file.type.startsWith("image/")) {
        showError("That file is not an image. Choose a JPG, PNG or WebP.");
        return;
      }
      if (file.size > 30 * 1024 * 1024) {
        showError("That image is over 30 MB. Resize it first and try again.");
        return;
      }
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        URL.revokeObjectURL(url);
        filenameEl.textContent = file.name;
        setSource(img, img.naturalWidth, img.naturalHeight);
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        showError("Your browser could not read that image. If it is a HEIC photo, export it as JPG or PNG first.");
      };
      img.src = url;
    }

    fileInput.addEventListener("change", () => {
      const f = fileInput.files && fileInput.files[0];
      if (f) loadFile(f);
      fileInput.value = "";
    });
    dropzone.addEventListener("dragover", (e) => {
      e.preventDefault();
      dropzone.classList.add("border-emerald-400", "bg-emerald-50");
    });
    dropzone.addEventListener("dragleave", () => {
      dropzone.classList.remove("border-emerald-400", "bg-emerald-50");
    });
    dropzone.addEventListener("drop", (e) => {
      e.preventDefault();
      dropzone.classList.remove("border-emerald-400", "bg-emerald-50");
      const f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
      if (f) loadFile(f);
    });
    sampleBtn.addEventListener("click", () => {
      filenameEl.textContent = "Sample landscape";
      setSource(drawSample(), 640, 420);
    });

    methodSel.addEventListener("change", () => {
      state.method = methodSel.value;
      schedule();
    });
    ditherSel.addEventListener("change", () => {
      state.dither = ditherSel.value;
      syncControls();
      schedule();
    });
    exportSel.addEventListener("change", () => {
      state.exportScale = Number(exportSel.value);
      syncControls();
      schedule();
    });
    alphaIn.addEventListener("change", () => {
      state.keepAlpha = alphaIn.checked;
      schedule();
    });

    const bindRange = (el: HTMLInputElement, key: "size" | "colors" | "strength" | "brightness" | "contrast" | "saturation") => {
      el.addEventListener("input", () => {
        state[key] = Number(el.value);
        syncControls();
        schedule();
      });
    };
    bindRange(sizeIn, "size");
    bindRange(colorsIn, "colors");
    bindRange(strengthIn, "strength");
    bindRange(brightIn, "brightness");
    bindRange(contrastIn, "contrast");
    bindRange(satIn, "saturation");

    downloadBtn.addEventListener("click", () => {
      if (!lastPx) return;
      const out = makeCanvas(1, 1);
      drawScaled(out, lastPx, state.exportScale);
      const name = "pixel-art-" + state.preset + "-" + lastPx.width + "x" + lastPx.height + ".png";
      out.toBlob((blob) => {
        if (!blob) return;
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = name;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }, "image/png");
    });

    resetBtn.addEventListener("click", () => {
      Object.assign(state, DEFAULTS);
      syncControls();
      schedule();
    });

    syncControls();
    render();
  }

  document.querySelectorAll<HTMLElement>("[data-pixel-art-converter-widget]").forEach(initPixelArtConverter);
</script>