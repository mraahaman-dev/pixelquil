---
// Custom Cursor Set Generator widget. Fully client-side.
---

<div data-custom-cursor-set-generator-widget class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-sm">
  <div class="grid gap-6 lg:grid-cols-[270px_1fr]">
    <!-- Controls -->
    <div class="space-y-6">
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-gray-400">1. Colors</p>
        <div class="mb-3 flex flex-wrap gap-2">
          <button type="button" data-preset="classic" class="rounded-full border border-gray-200 px-3 py-1 text-xs font-medium text-gray-700 hover:border-rose-300 hover:bg-rose-50">Classic</button>
          <button type="button" data-preset="inverted" class="rounded-full border border-gray-200 px-3 py-1 text-xs font-medium text-gray-700 hover:border-rose-300 hover:bg-rose-50">Inverted</button>
          <button type="button" data-preset="neon" class="rounded-full border border-gray-200 px-3 py-1 text-xs font-medium text-gray-700 hover:border-rose-300 hover:bg-rose-50">Neon</button>
          <button type="button" data-preset="rose" class="rounded-full border border-gray-200 px-3 py-1 text-xs font-medium text-gray-700 hover:border-rose-300 hover:bg-rose-50">Rose</button>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <label class="block text-xs text-gray-600">
            Fill
            <input type="color" data-fill value="#000000" class="mt-1 block h-9 w-full cursor-pointer rounded-lg border border-gray-200 bg-white p-1" />
          </label>
          <label class="block text-xs text-gray-600">
            Outline
            <input type="color" data-outline value="#ffffff" class="mt-1 block h-9 w-full cursor-pointer rounded-lg border border-gray-200 bg-white p-1" />
          </label>
        </div>
      </div>

      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-gray-400">2. Size and effects</p>
        <label class="block text-xs text-gray-600">
          Outline width: <span data-ow-label class="font-medium text-gray-900">1.5</span>
          <input type="range" data-ow min="0" max="3" step="0.5" value="1.5" class="mt-1 w-full accent-rose-600" />
        </label>
        <label class="mt-4 block text-xs text-gray-600">
          Export size
          <select data-size class="mt-1 block w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-800 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500">
            <option value="32" selected>32 px (safest everywhere)</option>
            <option value="48">48 px</option>
            <option value="64">64 px</option>
          </select>
        </label>
        <label class="mt-4 flex items-center gap-2 text-sm text-gray-700">
          <input type="checkbox" data-shadow class="h-4 w-4 rounded border-gray-300 accent-rose-600" />
          Soft drop shadow
        </label>
      </div>

      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-gray-400">3. CSS format</p>
        <select data-format class="block w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-800 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500">
          <option value="classes" selected>Utility classes (.cursor-pointer)</option>
          <option value="global">Global rules (a, button, input, and so on)</option>
        </select>
      </div>
    </div>

    <!-- States -->
    <div>
      <div class="mb-3 flex items-center justify-between">
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">4. Cursor states</p>
        <div class="flex gap-3 text-xs">
          <button type="button" data-all class="text-gray-500 hover:text-rose-600">Select all</button>
          <button type="button" data-none class="text-gray-500 hover:text-rose-600">Select none</button>
        </div>
      </div>
      <p class="mb-3 text-xs text-gray-500">Move your mouse over a card to try that cursor. Tick the states to export and adjust the hotspot if the click point feels off.</p>
      <div data-grid class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-4"></div>

      <div class="mt-5 flex flex-wrap items-center gap-3 border-t border-gray-100 pt-5">
        <button type="button" data-download-zip class="rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:ring-offset-2">
          Download ZIP (SVGs + CSS)
        </button>
        <button type="button" data-copy-css class="inline-flex items-center gap-2 rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
          <svg data-copy-icon class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <svg data-copy-done class="hidden h-4 w-4 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
          <span data-copy-label>Copy CSS</span>
        </button>
        <button type="button" data-reset class="ml-auto text-sm text-gray-400 hover:text-red-600">Reset</button>
      </div>

      <details class="mt-4 rounded-lg border border-gray-200">
        <summary class="cursor-pointer px-4 py-2 text-sm font-medium text-gray-700">Preview the generated CSS</summary>
        <textarea data-css readonly rows="10" class="block w-full resize-y rounded-b-lg border-t border-gray-200 bg-gray-50 p-3 font-mono text-xs text-gray-700 focus:outline-none"></textarea>
      </details>
    </div>
  </div>
</div>

<script>
  type State = {
    id: string;
    label: string;
    css: string;
    hot: [number, number];
    lw?: number;
    F?: string;
    L?: string;
  };

  const ARROW =
    '<path d="M6 3 L6 25 L11.5 20 L15.5 28.5 L19 27 L15 18.5 L22.5 18.5 Z"/>';

  const STATES: State[] = [
    { id: "default", label: "Default", css: "default", hot: [6, 3], F: ARROW },
    {
      id: "pointer",
      label: "Pointer (link)",
      css: "pointer",
      hot: [13, 3],
      F: '<rect x="11" y="3" width="5" height="16" rx="2.5"/><rect x="11" y="14" width="16" height="13" rx="5"/><rect x="7" y="15" width="6" height="8" rx="3"/>',
    },
    {
      id: "text",
      label: "Text",
      css: "text",
      hot: [16, 16],
      lw: 2,
      L: '<path d="M16 5 V27 M11 5 H21 M11 27 H21"/>',
    },
    {
      id: "crosshair",
      label: "Crosshair",
      css: "crosshair",
      hot: [16, 16],
      lw: 2,
      L: '<path d="M16 4 V28 M4 16 H28"/>',
    },
    {
      id: "move",
      label: "Move",
      css: "move",
      hot: [16, 16],
      lw: 2,
      L: '<path d="M16 4 V28 M4 16 H28 M12 8 L16 4 L20 8 M12 24 L16 28 L20 24 M8 12 L4 16 L8 20 M24 12 L28 16 L24 20"/>',
    },
    {
      id: "not-allowed",
      label: "Not allowed",
      css: "not-allowed",
      hot: [16, 16],
      lw: 3,
      L: '<circle cx="16" cy="16" r="10.5"/><path d="M8.6 8.6 L23.4 23.4"/>',
    },
    {
      id: "wait",
      label: "Wait",
      css: "wait",
      hot: [16, 16],
      lw: 3.5,
      L: '<path d="M16 5 A11 11 0 1 1 5 16"/>',
    },
    {
      id: "help",
      label: "Help",
      css: "help",
      hot: [5, 3],
      lw: 2,
      F: '<path transform="translate(1 1) scale(0.8)" d="M6 3 L6 25 L11.5 20 L15.5 28.5 L19 27 L15 18.5 L22.5 18.5 Z"/><circle cx="23.5" cy="26" r="1.6"/>',
      L: '<path d="M20 14.5 a3.5 3.5 0 1 1 5.2 3 c-1.2 0.7-1.7 1.4-1.7 2.8"/>',
    },
    {
      id: "grab",
      label: "Grab",
      css: "grab",
      hot: [16, 16],
      F: '<rect x="7" y="13" width="18" height="14" rx="6"/><circle cx="11" cy="12.5" r="3.2"/><circle cx="16" cy="11.5" r="3.2"/><circle cx="21" cy="12.5" r="3.2"/>',
    },
    {
      id: "ns-resize",
      label: "Resize vertical",
      css: "ns-resize",
      hot: [16, 16],
      lw: 2,
      L: '<path d="M16 4 V28 M12 8 L16 4 L20 8 M12 24 L16 28 L20 24"/>',
    },
    {
      id: "ew-resize",
      label: "Resize horizontal",
      css: "ew-resize",
      hot: [16, 16],
      lw: 2,
      L: '<path d="M4 16 H28 M8 12 L4 16 L8 20 M24 12 L28 16 L24 20"/>',
    },
    {
      id: "zoom-in",
      label: "Zoom in",
      css: "zoom-in",
      hot: [13, 13],
      lw: 2.5,
      L: '<circle cx="13" cy="13" r="8"/><path d="M19 19 L27 27 M13 9.5 V16.5 M9.5 13 H16.5"/>',
    },
  ];

  const PRESETS: Record<string, { fill: string; outline: string; ow: number }> = {
    classic: { fill: "#000000", outline: "#ffffff", ow: 1.5 },
    inverted: { fill: "#ffffff", outline: "#000000", ow: 1.5 },
    neon: { fill: "#a3e635", outline: "#1a2e05", ow: 1.5 },
    rose: { fill: "#e11d48", outline: "#ffffff", ow: 1.5 },
  };

  const GLOBAL_SELECTORS: Record<string, string> = {
    default: "html, body",
    pointer: 'a, button, [role="button"], summary, select, label[for]',
    text: 'input:not([type]), input[type="text"], input[type="email"], input[type="search"], input[type="url"], input[type="password"], textarea',
    "not-allowed": '[disabled], [aria-disabled="true"], .disabled',
    wait: ".is-loading",
  };

  // ---- ZIP (store only, no compression) ----
  const crcTable = (() => {
    const t = new Uint32Array(256);
    for (let n = 0; n < 256; n++) {
      let c = n;
      for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
      t[n] = c >>> 0;
    }
    return t;
  })();

  function crc32(buf: Uint8Array): number {
    let c = 0xffffffff;
    for (let i = 0; i < buf.length; i++) c = crcTable[(c ^ buf[i]) & 0xff] ^ (c >>> 8);
    return (c ^ 0xffffffff) >>> 0;
  }

  function makeZip(files: { name: string; data: Uint8Array }[]): Blob {
    const enc = new TextEncoder();
    const parts: Uint8Array[] = [];
    const central: Uint8Array[] = [];
    let offset = 0;
    for (const f of files) {
      const nameBytes = enc.encode(f.name);
      const crc = crc32(f.data);
      const local = new DataView(new ArrayBuffer(30));
      local.setUint32(0, 0x04034b50, true);
      local.setUint16(4, 20, true);
      local.setUint16(6, 0x0800, true);
      local.setUint16(8, 0, true);
      local.setUint16(10, 0, true);
      local.setUint16(12, 0x21, true);
      local.setUint32(14, crc, true);
      local.setUint32(18, f.data.length, true);
      local.setUint32(22, f.data.length, true);
      local.setUint16(26, nameBytes.length, true);
      local.setUint16(28, 0, true);
      parts.push(new Uint8Array(local.buffer), nameBytes, f.data);

      const cen = new DataView(new ArrayBuffer(46));
      cen.setUint32(0, 0x02014b50, true);
      cen.setUint16(4, 20, true);
      cen.setUint16(6, 20, true);
      cen.setUint16(8, 0x0800, true);
      cen.setUint16(10, 0, true);
      cen.setUint16(12, 0, true);
      cen.setUint16(14, 0x21, true);
      cen.setUint32(16, crc, true);
      cen.setUint32(20, f.data.length, true);
      cen.setUint32(24, f.data.length, true);
      cen.setUint16(28, nameBytes.length, true);
      cen.setUint32(42, offset, true);
      central.push(new Uint8Array(cen.buffer), nameBytes);
      offset += 30 + nameBytes.length + f.data.length;
    }
    let centralSize = 0;
    for (const c of central) centralSize += c.length;
    const end = new DataView(new ArrayBuffer(22));
    end.setUint32(0, 0x06054b50, true);
    end.setUint16(8, files.length, true);
    end.setUint16(10, files.length, true);
    end.setUint32(12, centralSize, true);
    end.setUint32(16, offset, true);
    return new Blob([...parts, ...central, new Uint8Array(end.buffer)] as BlobPart[], {
      type: "application/zip",
    });
  }

  function download(blob: Blob, name: string) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = name;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  function initCursorSet(root: HTMLElement) {
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const fillEl = q<HTMLInputElement>("[data-fill]");
    const outlineEl = q<HTMLInputElement>("[data-outline]");
    const owEl = q<HTMLInputElement>("[data-ow]");
    const owLabel = q<HTMLElement>("[data-ow-label]");
    const sizeEl = q<HTMLSelectElement>("[data-size]");
    const shadowEl = q<HTMLInputElement>("[data-shadow]");
    const formatEl = q<HTMLSelectElement>("[data-format]");
    const grid = q<HTMLElement>("[data-grid]");
    const cssEl = q<HTMLTextAreaElement>("[data-css]");
    const zipBtn = q<HTMLButtonElement>("[data-download-zip]");
    const copyBtn = q<HTMLButtonElement>("[data-copy-css]");
    const copyIcon = q<SVGElement>("[data-copy-icon]");
    const copyDone = q<SVGElement>("[data-copy-done]");
    const copyLabel = q<HTMLElement>("[data-copy-label]");

    const included: Record<string, boolean> = {};
    const hot: Record<string, [number, number]> = {};
    function resetStates() {
      STATES.forEach((s) => {
        included[s.id] = true;
        hot[s.id] = [s.hot[0], s.hot[1]];
      });
    }
    resetStates();

    function buildSvg(st: State, size: number): string {
      const fill = fillEl.value;
      const outline = outlineEl.value;
      const ow = parseFloat(owEl.value);
      const lw = st.lw || 2;
      const F = st.F || "";
      const L = st.L || "";
      let body = "";
      if (ow > 0) {
        body += `<g fill="${outline}" stroke="${outline}" stroke-width="${ow * 2}" stroke-linejoin="round" stroke-linecap="round">${F}</g>`;
        if (L) body += `<g fill="none" stroke="${outline}" stroke-width="${lw + ow * 2}" stroke-linejoin="round" stroke-linecap="round">${L}</g>`;
      }
      body += `<g fill="${fill}" stroke="none">${F}</g>`;
      if (L) body += `<g fill="none" stroke="${fill}" stroke-width="${lw}" stroke-linejoin="round" stroke-linecap="round">${L}</g>`;
      let inner = body;
      let defs = "";
      if (shadowEl.checked) {
        defs = '<defs><filter id="sh" x="-30%" y="-30%" width="170%" height="170%"><feDropShadow dx="0.8" dy="1.2" stdDeviation="1" flood-color="#000000" flood-opacity="0.35"/></filter></defs>';
        inner = `<g filter="url(#sh)">${body}</g>`;
      }
      return `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 32 32">${defs}${inner}</svg>`;
    }

    function cursorValue(st: State, size: number): string {
      const svg = buildSvg(st, size);
      const scale = size / 32;
      const hx = Math.round(hot[st.id][0] * scale);
      const hy = Math.round(hot[st.id][1] * scale);
      return `url("data:image/svg+xml,${encodeURIComponent(svg)}") ${hx} ${hy}, ${st.css}`;
    }

    function buildCss(): string {
      const size = parseInt(sizeEl.value, 10);
      const global = formatEl.value === "global";
      const lines: string[] = ["/* Generated by Pixelquil Custom Cursor Set Generator */"];
      STATES.filter((s) => included[s.id]).forEach((s) => {
        const sel = global && GLOBAL_SELECTORS[s.id] ? GLOBAL_SELECTORS[s.id] : `.cursor-${s.id}`;
        lines.push(`${sel} {\n  cursor: ${cursorValue(s, size)};\n}`);
      });
      return lines.join("\n\n");
    }

    function buildGrid() {
      grid.innerHTML = "";
      STATES.forEach((s) => {
        const card = document.createElement("div");
        card.className = "rounded-xl border border-gray-200 p-3 hover:border-rose-300";
        card.setAttribute("data-card", s.id);
        card.innerHTML = `
          <div class="flex items-center justify-between">
            <label class="flex items-center gap-2 text-xs font-medium text-gray-700">
              <input type="checkbox" data-inc class="h-4 w-4 rounded border-gray-300 accent-rose-600" checked />
              ${s.label}
            </label>
          </div>
          <div data-stage class="mt-2 flex h-20 items-center justify-center rounded-lg bg-gray-100"></div>
          <div class="mt-2 flex items-center gap-1 text-[11px] text-gray-500">
            <span>Hotspot</span>
            <input type="number" data-hx min="0" max="31" class="w-11 rounded border border-gray-200 px-1 py-0.5 text-gray-800" />
            <input type="number" data-hy min="0" max="31" class="w-11 rounded border border-gray-200 px-1 py-0.5 text-gray-800" />
            <button type="button" data-dl class="ml-auto text-gray-500 hover:text-rose-600">SVG</button>
          </div>`;
        grid.appendChild(card);

        const inc = card.querySelector<HTMLInputElement>("[data-inc]")!;
        const hx = card.querySelector<HTMLInputElement>("[data-hx]")!;
        const hy = card.querySelector<HTMLInputElement>("[data-hy]")!;
        inc.addEventListener("change", () => {
          included[s.id] = inc.checked;
          refreshCss();
        });
        const onHot = () => {
          hot[s.id] = [
            Math.min(31, Math.max(0, parseInt(hx.value, 10) || 0)),
            Math.min(31, Math.max(0, parseInt(hy.value, 10) || 0)),
          ];
          renderCards();
        };
        hx.addEventListener("input", onHot);
        hy.addEventListener("input", onHot);
        card.querySelector<HTMLButtonElement>("[data-dl]")!.addEventListener("click", () => {
          const size = parseInt(sizeEl.value, 10);
          download(new Blob([buildSvg(s, size)], { type: "image/svg+xml" }), `cursor-${s.id}.svg`);
        });
      });
    }

    function renderCards() {
      const size = parseInt(sizeEl.value, 10);
      STATES.forEach((s) => {
        const card = grid.querySelector<HTMLElement>(`[data-card="${s.id}"]`)!;
        const stage = card.querySelector<HTMLElement>("[data-stage]")!;
        const inc = card.querySelector<HTMLInputElement>("[data-inc]")!;
        const hx = card.querySelector<HTMLInputElement>("[data-hx]")!;
        const hy = card.querySelector<HTMLInputElement>("[data-hy]")!;
        stage.innerHTML = buildSvg(s, 56).replace(/<svg /, '<svg style="pointer-events:none" ');
        stage.style.cursor = cursorValue(s, size);
        inc.checked = included[s.id];
        if (document.activeElement !== hx) hx.value = String(hot[s.id][0]);
        if (document.activeElement !== hy) hy.value = String(hot[s.id][1]);
      });
      refreshCss();
    }

    function refreshCss() {
      cssEl.value = buildCss();
    }

    // Controls
    [fillEl, outlineEl, sizeEl, shadowEl].forEach((el) => el.addEventListener("input", renderCards));
    sizeEl.addEventListener("change", renderCards);
    shadowEl.addEventListener("change", renderCards);
    owEl.addEventListener("input", () => {
      owLabel.textContent = owEl.value;
      renderCards();
    });
    formatEl.addEventListener("change", refreshCss);

    root.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const p = PRESETS[btn.dataset.preset || "classic"];
        fillEl.value = p.fill;
        outlineEl.value = p.outline;
        owEl.value = String(p.ow);
        owLabel.textContent = String(p.ow);
        renderCards();
      });
    });

    q<HTMLButtonElement>("[data-all]").addEventListener("click", () => {
      STATES.forEach((s) => (included[s.id] = true));
      renderCards();
    });
    q<HTMLButtonElement>("[data-none]").addEventListener("click", () => {
      STATES.forEach((s) => (included[s.id] = false));
      renderCards();
    });

    q<HTMLButtonElement>("[data-reset]").addEventListener("click", () => {
      fillEl.value = "#000000";
      outlineEl.value = "#ffffff";
      owEl.value = "1.5";
      owLabel.textContent = "1.5";
      sizeEl.value = "32";
      shadowEl.checked = false;
      formatEl.value = "classes";
      resetStates();
      renderCards();
    });

    zipBtn.addEventListener("click", () => {
      const size = parseInt(sizeEl.value, 10);
      const enc = new TextEncoder();
      const picked = STATES.filter((s) => included[s.id]);
      if (!picked.length) return;
      const files = picked.map((s) => ({
        name: `cursors/cursor-${s.id}.svg`,
        data: enc.encode(buildSvg(s, size)),
      }));
      files.push({ name: "cursors.css", data: enc.encode(buildCss()) });
      download(makeZip(files), "cursor-set.zip");
    });

    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(buildCss());
      } catch {
        cssEl.select();
        document.execCommand("copy");
      }
      copyIcon.classList.add("hidden");
      copyDone.classList.remove("hidden");
      copyLabel.textContent = "Copied";
      setTimeout(() => {
        copyIcon.classList.remove("hidden");
        copyDone.classList.add("hidden");
        copyLabel.textContent = "Copy CSS";
      }, 1500);
    });

    buildGrid();
    renderCards();
  }

  document.querySelectorAll<HTMLElement>("[data-custom-cursor-set-generator-widget]").forEach(initCursorSet);
</script>