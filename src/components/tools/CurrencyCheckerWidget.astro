<div data-currency-checker-widget class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-sm">
  <div class="mb-6">
    <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">1. Font to Test</p>
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
      <input
        data-font-name
        type="text"
        value="system-ui"
        placeholder="e.g. Poppins, Arial, system-ui"
        class="flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500"
      />
      <label class="flex shrink-0 items-center gap-2 text-xs text-gray-600">
        <input data-google-font-toggle type="checkbox" class="rounded border-gray-300 text-sky-600 focus:ring-sky-500" />
        This is a Google Font (load it automatically)
      </label>
    </div>
    <p data-font-status class="mt-1.5 text-xs text-gray-400">&nbsp;</p>
  </div>

  <div class="mb-6">
    <div class="mb-2 flex items-center justify-between">
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">2. Currency Symbols to Test</p>
      <div class="flex gap-2">
        <button type="button" data-select-all class="text-xs font-medium text-sky-600 hover:underline">Select all</button>
        <button type="button" data-select-none class="text-xs font-medium text-gray-400 hover:underline">Select none</button>
      </div>
    </div>
    <div data-symbol-grid class="grid grid-cols-2 gap-1.5 sm:grid-cols-3 md:grid-cols-4"></div>
    <div class="mt-3">
      <label class="mb-1 block text-xs font-medium text-gray-600">Add custom characters (optional, space or comma separated)</label>
      <input
        data-custom-chars
        type="text"
        placeholder="e.g. ₿ ﷼"
        class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500"
      />
    </div>
  </div>

  <div>
    <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">3. Results</p>
    <p data-summary class="mb-3 text-sm text-gray-600">&nbsp;</p>
    <p data-fallback-warning class="mb-3 hidden rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-700">
      Most symbols look unsupported — double-check the font name is spelled correctly and (if it's a Google Font) that the toggle above is checked.
    </p>
    <div data-results-grid class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4"></div>
    <p class="mt-3 text-xs text-gray-400">
      The badge is a heuristic based on glyph width comparison — always trust what you see in the large preview over the badge if they disagree.
    </p>
  </div>
</div>

<script>
  type CurrencySymbol = { char: string; name: string; codepoint: string };

  const SYMBOLS: CurrencySymbol[] = [
    { char: "$", name: "Dollar", codepoint: "U+0024" },
    { char: "€", name: "Euro", codepoint: "U+20AC" },
    { char: "£", name: "Pound Sterling", codepoint: "U+00A3" },
    { char: "¥", name: "Yen / Yuan", codepoint: "U+00A5" },
    { char: "₹", name: "Indian Rupee", codepoint: "U+20B9" },
    { char: "₩", name: "Won", codepoint: "U+20A9" },
    { char: "₽", name: "Russian Ruble", codepoint: "U+20BD" },
    { char: "₺", name: "Turkish Lira", codepoint: "U+20BA" },
    { char: "₫", name: "Vietnamese Dong", codepoint: "U+20AB" },
    { char: "₴", name: "Ukrainian Hryvnia", codepoint: "U+20B4" },
    { char: "₦", name: "Nigerian Naira", codepoint: "U+20A6" },
    { char: "₱", name: "Philippine Peso", codepoint: "U+20B1" },
    { char: "₪", name: "Israeli Shekel", codepoint: "U+20AA" },
    { char: "₡", name: "Costa Rican Colón", codepoint: "U+20A1" },
    { char: "₲", name: "Paraguayan Guaraní", codepoint: "U+20B2" },
    { char: "₵", name: "Ghanaian Cedi", codepoint: "U+20B5" },
    { char: "₸", name: "Kazakhstani Tenge", codepoint: "U+20B8" },
    { char: "₭", name: "Lao Kip", codepoint: "U+20AD" },
    { char: "₮", name: "Mongolian Tögrög", codepoint: "U+20AE" },
    { char: "฿", name: "Thai Baht", codepoint: "U+0E3F" },
    { char: "₣", name: "French Franc (historical)", codepoint: "U+20A3" },
    { char: "₿", name: "Bitcoin", codepoint: "U+20BF" },
  ];

  const DEFAULT_SELECTED = new Set(["$", "€", "£", "¥", "₹", "₩", "₽", "₫", "₦", "₱"]);
  const PUA_CHAR = "\uE000";

  function initCurrencyChecker(root: HTMLElement) {
    const fontInput = root.querySelector<HTMLInputElement>("[data-font-name]")!;
    const googleToggle = root.querySelector<HTMLInputElement>("[data-google-font-toggle]")!;
    const fontStatus = root.querySelector<HTMLElement>("[data-font-status]")!;
    const symbolGrid = root.querySelector<HTMLElement>("[data-symbol-grid]")!;
    const selectAllBtn = root.querySelector<HTMLButtonElement>("[data-select-all]")!;
    const selectNoneBtn = root.querySelector<HTMLButtonElement>("[data-select-none]")!;
    const customCharsInput = root.querySelector<HTMLInputElement>("[data-custom-chars]")!;
    const summary = root.querySelector<HTMLElement>("[data-summary]")!;
    const fallbackWarning = root.querySelector<HTMLElement>("[data-fallback-warning]")!;
    const resultsGrid = root.querySelector<HTMLElement>("[data-results-grid]")!;

    const canvas = document.createElement("canvas");
    const ctx = canvas.getContext("2d")!;
    let injectedLink: HTMLLinkElement | null = null;
    let runToken = 0;

    function measureWidth(fontFamily: string, char: string, size = 48): number {
      const safeFamily = fontFamily.replace(/"/g, "");
      ctx.font = `${size}px "${safeFamily}"`;
      return ctx.measureText(char).width;
    }

    function customCharsList(): string[] {
      return customCharsInput.value
        .split(/[\s,]+/)
        .map((s) => s.trim())
        .filter(Boolean);
    }

    function selectedChars(): { char: string; name: string; codepoint: string }[] {
      const checked: { char: string; name: string; codepoint: string }[] = [];
      symbolGrid.querySelectorAll<HTMLInputElement>("[data-symbol-checkbox]").forEach((cb) => {
        if (cb.checked) {
          const sym = SYMBOLS.find((s) => s.char === cb.value);
          if (sym) checked.push(sym);
        }
      });
      for (const c of customCharsList()) {
        checked.push({
          char: c,
          name: "Custom",
          codepoint: "U+" + (c.codePointAt(0) || 0).toString(16).toUpperCase().padStart(4, "0"),
        });
      }
      return checked;
    }

    function renderSymbolGrid() {
      symbolGrid.innerHTML = "";
      for (const sym of SYMBOLS) {
        const label = document.createElement("label");
        label.className = "flex items-center gap-1.5 rounded-md border border-gray-200 px-2 py-1.5 text-xs text-gray-700 hover:border-sky-300";
        const cb = document.createElement("input");
        cb.type = "checkbox";
        cb.value = sym.char;
        cb.checked = DEFAULT_SELECTED.has(sym.char);
        cb.setAttribute("data-symbol-checkbox", "");
        cb.className = "rounded border-gray-300 text-sky-600 focus:ring-sky-500";
        cb.addEventListener("change", runCheck);
        const span = document.createElement("span");
        span.textContent = `${sym.char} ${sym.name}`;
        label.appendChild(cb);
        label.appendChild(span);
        symbolGrid.appendChild(label);
      }
    }

    async function ensureFontLoaded(): Promise<void> {
      const family = fontInput.value.trim() || "system-ui";
      if (injectedLink) {
        injectedLink.remove();
        injectedLink = null;
      }

      if (googleToggle.checked) {
        fontStatus.textContent = `Loading "${family}" from Google Fonts…`;
        const params = new URLSearchParams({ family: `${family}:wght@400;700`, display: "swap" });
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = `https://fonts.googleapis.com/css2?${params.toString()}`;
        injectedLink = link;
        await new Promise<void>((resolve) => {
          link.onload = () => resolve();
          link.onerror = () => resolve();
          document.head.appendChild(link);
        });
        try {
          if ("fonts" in document) {
            await (document as any).fonts.load(`48px "${family}"`);
          }
        } catch {
          // ignore — canvas measurement will still fall back gracefully
        }
        fontStatus.textContent = `Testing "${family}" (loaded from Google Fonts).`;
      } else {
        try {
          if ("fonts" in document) {
            await (document as any).fonts.load(`48px "${family}"`);
          }
        } catch {
          // ignore
        }
        fontStatus.textContent = `Testing "${family}".`;
      }
    }

    async function runCheck() {
      const token = ++runToken;
      await ensureFontLoaded();
      if (token !== runToken) return; // a newer run superseded this one

      const family = fontInput.value.trim() || "system-ui";
      const chars = selectedChars();
      resultsGrid.innerHTML = "";

      if (chars.length === 0) {
        summary.textContent = "Select at least one currency symbol above.";
        fallbackWarning.classList.add("hidden");
        return;
      }

      let supportedCount = 0;
      const puaWidth = measureWidth(family, PUA_CHAR);

      for (const sym of chars) {
        const w = measureWidth(family, sym.char);
        const supported = w > 0 && Math.abs(w - puaWidth) > 1.5;
        if (supported) supportedCount++;

        const card = document.createElement("div");
        card.className = "flex flex-col items-center rounded-lg border border-gray-200 p-3 text-center";

        const glyph = document.createElement("div");
        glyph.textContent = sym.char;
        glyph.style.fontFamily = `"${family.replace(/"/g, "")}"`;
        glyph.className = "mb-1.5 text-4xl text-gray-900";
        card.appendChild(glyph);

        const name = document.createElement("p");
        name.className = "text-xs font-medium text-gray-700";
        name.textContent = sym.name;
        card.appendChild(name);

        const code = document.createElement("p");
        code.className = "mb-1.5 text-[11px] text-gray-400";
        code.textContent = sym.codepoint;
        card.appendChild(code);

        const badge = document.createElement("span");
        badge.className = supported
          ? "rounded-full bg-green-100 px-2 py-0.5 text-[11px] font-medium text-green-700"
          : "rounded-full bg-red-100 px-2 py-0.5 text-[11px] font-medium text-red-600";
        badge.textContent = supported ? "Likely supported" : "Possibly missing";
        card.appendChild(badge);

        resultsGrid.appendChild(card);
      }

      summary.textContent = `${supportedCount} of ${chars.length} symbols look supported in "${family}".`;
      const unsupportedRatio = 1 - supportedCount / chars.length;
      fallbackWarning.classList.toggle("hidden", !(chars.length >= 3 && unsupportedRatio > 0.7));
    }

    selectAllBtn.addEventListener("click", () => {
      symbolGrid.querySelectorAll<HTMLInputElement>("[data-symbol-checkbox]").forEach((cb) => (cb.checked = true));
      runCheck();
    });
    selectNoneBtn.addEventListener("click", () => {
      symbolGrid.querySelectorAll<HTMLInputElement>("[data-symbol-checkbox]").forEach((cb) => (cb.checked = false));
      runCheck();
    });
    fontInput.addEventListener("change", runCheck);
    googleToggle.addEventListener("change", runCheck);
    customCharsInput.addEventListener("input", runCheck);

    renderSymbolGrid();
    runCheck();
  }

  document
    .querySelectorAll<HTMLElement>("[data-currency-checker-widget]")
    .forEach(initCurrencyChecker);
</script>