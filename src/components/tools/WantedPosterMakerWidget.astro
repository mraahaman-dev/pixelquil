---
const inputCls =
  "mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500";
const labelCls = "block text-sm font-medium text-gray-700";
const headCls = "mb-3 text-xs font-semibold uppercase tracking-wide text-gray-400";
---

<div
  data-wanted-poster-maker-widget
  class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-sm"
>
  <div class="grid gap-6 lg:grid-cols-2">
    <!-- Controls -->
    <div class="min-w-0 space-y-6">
      <div>
        <p class={headCls}>1. Poster text</p>
        <div class="space-y-3">
          <label class={labelCls}>
            Heading
            <input data-heading type="text" maxlength="24" value="WANTED" class={inputCls} />
          </label>
          <div class="grid gap-3 sm:grid-cols-2">
            <label class={labelCls}>
              Name
              <input data-name type="text" maxlength="40" value="Silas River" class={inputCls} />
            </label>
            <label class={labelCls}>
              Alias (a.k.a.)
              <input data-alias type="text" maxlength="40" value="The Neon Fox" class={inputCls} />
            </label>
          </div>
          <label class={labelCls}>
            Fictional charge
            <textarea
              data-charge
              rows="2"
              maxlength="120"
              class={inputCls}>Stealing the moon from the Palm City museum</textarea>
          </label>
          <div class="grid grid-cols-3 gap-3">
            <label class={labelCls}>
              Currency
              <select data-currency class={inputCls}>
                <option value="$" selected>$</option>
                <option value="৳">৳</option>
                <option value="£">£</option>
                <option value="€">€</option>
                <option value="₹">₹</option>
                <option value="¥">¥</option>
                <option value="">None</option>
              </select>
            </label>
            <label class={labelCls + " col-span-2"}>
              Reward
              <input data-reward type="text" maxlength="24" value="50000" class={inputCls} />
            </label>
          </div>
          <label class={labelCls}>
            Last seen (optional)
            <input
              data-last
              type="text"
              maxlength="60"
              value="Ocean Drive, near the old motel"
              class={inputCls}
            />
          </label>
          <label class={labelCls}>
            Footer line (optional)
            <input
              data-footer
              type="text"
              maxlength="70"
              value="Reward paid for information leading to capture"
              class={inputCls}
            />
          </label>
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <input
              data-fine
              type="checkbox"
              checked
              class="h-4 w-4 rounded border-gray-300 text-orange-600 focus:ring-orange-500"
            />
            Add "Fictional poster, not a real notice" fine print
          </label>
        </div>
      </div>

      <div>
        <p class={headCls}>2. Portrait</p>
        <div class="mb-3 inline-flex overflow-hidden rounded-lg border border-gray-300 text-sm font-medium">
          <button
            type="button"
            data-mode-btn
            data-value="silhouette"
            class="bg-orange-600 px-4 py-2 text-white">Pixel silhouette</button
          >
          <button
            type="button"
            data-mode-btn
            data-value="photo"
            class="bg-white px-4 py-2 text-gray-700 hover:bg-orange-50">Pixelate a photo</button
          >
        </div>

        <div data-silhouette-panel class="grid gap-3 sm:grid-cols-2">
          <label class={labelCls}>
            Hat
            <select data-hat class={inputCls}>
              <option value="wide" selected>Wide-brim hat</option>
              <option value="cap">Baseball cap</option>
              <option value="hood">Hood</option>
              <option value="none">No hat</option>
            </select>
          </label>
          <label class={labelCls}>
            Accessory
            <select data-acc class={inputCls}>
              <option value="none" selected>None</option>
              <option value="sunglasses">Sunglasses</option>
              <option value="mustache">Mustache</option>
              <option value="bandana">Bandana</option>
            </select>
          </label>
        </div>

        <div data-photo-panel class="hidden space-y-3">
          <label
            data-dropzone
            class="flex cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-gray-300 px-4 py-6 text-center text-sm text-gray-600 hover:border-orange-400 hover:bg-orange-50"
          >
            <svg
              class="mb-2 h-8 w-8 text-gray-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 14.9A7 7 0 1 1 15.7 8h1.8a4.5 4.5 0 0 1 2.5 8.2"></path>
              <path d="M12 12v9"></path>
              <path d="m16 16-4-4-4 4"></path>
            </svg>
            <span class="font-medium text-gray-700">Drop a photo here or click to choose</span>
            <span class="mt-1 text-xs text-gray-500">JPG, PNG or WebP. It never leaves your device.</span>
            <span data-file-name class="mt-2 text-xs font-medium text-orange-700"></span>
            <input data-file type="file" accept="image/*" class="sr-only" />
          </label>
          <div class="flex flex-wrap items-center gap-3">
            <button
              type="button"
              data-sample
              class="rounded-lg border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
              >Try a sample</button
            >
          </div>
          <label class={labelCls}>
            Detail: <span data-blocks-label>48 blocks wide</span>
            <input
              data-blocks
              type="range"
              min="16"
              max="80"
              step="2"
              value="48"
              class="mt-2 w-full accent-orange-600"
            />
          </label>
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <input
              data-dither
              type="checkbox"
              checked
              class="h-4 w-4 rounded border-gray-300 text-orange-600 focus:ring-orange-500"
            />
            Dither (retro shading)
          </label>
          <div class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">
            Use photos for fiction, games and parties. Do not make a poster of a real person without their
            permission.
          </div>
        </div>
      </div>

      <div>
        <p class={headCls}>3. Style</p>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class={labelCls}>
            Theme
            <select data-theme class={inputCls}>
              <option value="west" selected>Old west parchment</option>
              <option value="neon">Neon night</option>
              <option value="noir">Pixel noir</option>
              <option value="clean">Clean reward board</option>
            </select>
          </label>
          <label class={labelCls}>
            Size
            <select data-size class={inputCls}>
              <option value="poster" selected>Poster 3:4 (1200 x 1600)</option>
              <option value="story">Story 9:16 (1080 x 1920)</option>
            </select>
          </label>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <button
          type="button"
          data-download
          class="rounded-lg bg-orange-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2"
          >Download PNG</button
        >
        <button
          type="button"
          data-copy
          class="inline-flex items-center gap-2 rounded-lg border border-gray-300 px-4 py-2.5 text-sm font-semibold text-gray-700 hover:bg-gray-50"
        >
          <svg
            data-copy-icon
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <svg
            data-copy-check
            class="hidden h-4 w-4 text-green-600"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
          <span data-copy-label>Copy image</span>
        </button>
        <button type="button" data-reset class="ml-auto text-sm text-gray-400 hover:text-red-600">Reset</button>
      </div>
      <p data-status class="min-h-5 text-sm text-red-600" role="status" aria-live="polite"></p>
    </div>

    <!-- Preview -->
    <div class="min-w-0 lg:sticky lg:top-6 lg:self-start">
      <p class={headCls}>Live preview</p>
      <canvas
        data-canvas
        width="1200"
        height="1600"
        role="img"
        aria-label="Wanted poster preview"
        class="h-auto w-full rounded-xl border border-gray-200 bg-gray-50"></canvas>
    </div>
  </div>
</div>

<script>
  type Sil = { body: string; face: string; hat: string; band: string; glint: string };
  type Theme = {
    bg: string;
    bg2: string;
    ink: string;
    muted: string;
    accent: string;
    border: string;
    portraitBg: string;
    pal: string[];
    head: string;
    body: string;
    style: "paper" | "neon" | "noir" | "clean";
    sil: Sil;
  };

  const THEMES: Record<string, Theme> = {
    west: {
      bg: "#e8d5a3",
      bg2: "#d6bd84",
      ink: "#2b1a0e",
      muted: "#5a3d22",
      accent: "#8b1a1a",
      border: "#2b1a0e",
      portraitBg: "#cfb06f",
      pal: ["#2b1a0e", "#6b4423", "#b98a52", "#ead7a8"],
      head: 'Georgia, "Times New Roman", serif',
      body: 'Georgia, "Times New Roman", serif',
      style: "paper",
      sil: { body: "#5a3a1e", face: "#a8743f", hat: "#2b1a0e", band: "#8b1a1a", glint: "" },
    },
    neon: {
      bg: "#0d0221",
      bg2: "#1a0638",
      ink: "#f5e9ff",
      muted: "#c9b3ee",
      accent: "#ff2e93",
      border: "#2ef2ff",
      portraitBg: "#14052e",
      pal: ["#14052e", "#7a1fa2", "#ff2e93", "#2ef2ff"],
      head: '"Courier New", Courier, monospace',
      body: '"Courier New", Courier, monospace',
      style: "neon",
      sil: { body: "#3b0a6b", face: "#ff2e93", hat: "#0a0118", band: "#2ef2ff", glint: "#2ef2ff" },
    },
    noir: {
      bg: "#141414",
      bg2: "#1f1f1f",
      ink: "#ececec",
      muted: "#a8a8a8",
      accent: "#d63a2f",
      border: "#ececec",
      portraitBg: "#2f2f2f",
      pal: ["#0a0a0a", "#3a3a3a", "#9a9a9a", "#e8e8e8"],
      head: 'Impact, "Arial Narrow", "Arial Black", sans-serif',
      body: 'Arial, Helvetica, sans-serif',
      style: "noir",
      sil: { body: "#0a0a0a", face: "#9a9a9a", hat: "#000000", band: "#d63a2f", glint: "" },
    },
    clean: {
      bg: "#fafaf7",
      bg2: "#fafaf7",
      ink: "#1f2937",
      muted: "#6b7280",
      accent: "#ea580c",
      border: "#1f2937",
      portraitBg: "#e5e7eb",
      pal: ["#1f2937", "#4b5563", "#9ca3af", "#f3f4f6"],
      head: '"Arial Black", Arial, sans-serif',
      body: 'Arial, Helvetica, sans-serif',
      style: "clean",
      sil: { body: "#374151", face: "#9ca3af", hat: "#111827", band: "#ea580c", glint: "" },
    },
  };

  const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5];
  const GRID_W = 32;
  const GRID_H = 36;

  const DEFAULTS = {
    heading: "WANTED",
    name: "Silas River",
    alias: "The Neon Fox",
    charge: "Stealing the moon from the Palm City museum",
    currency: "$",
    reward: "50000",
    last: "Ocean Drive, near the old motel",
    footer: "Reward paid for information leading to capture",
    hat: "wide",
    acc: "none",
    blocks: "48",
    theme: "west",
    size: "poster",
  };

  function hashString(s: string): number {
    let h = 2166136261;
    for (let i = 0; i < s.length; i++) {
      h ^= s.charCodeAt(i);
      h = Math.imul(h, 16777619);
    }
    return h >>> 0;
  }

  function makeRng(seed: number) {
    let s = seed || 1;
    return () => {
      s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
      return s / 4294967296;
    };
  }

  function silColor(gx: number, gy: number, S: Sil, hat: string, acc: string): string | null {
    const dx = gx - 15.5;
    let c: string | null = null;

    if (gy >= 25) {
      const hw = Math.min(15.5, 7 + (gy - 25) * 1.6);
      if (Math.abs(dx) <= hw) c = S.body;
    }
    if (gy >= 21 && gy < 26 && Math.abs(dx) <= 2.6) c = S.face;

    if (hat === "hood") {
      const hx = dx / 9.6;
      const hy = (gy - 14.5) / 12;
      if (hx * hx + hy * hy <= 1) c = S.hat;
      if (gy >= 23 && gy <= 27 && Math.abs(dx) <= 9.5) c = S.hat;
    }

    const fx = hat === "hood" ? 5.6 : 7.2;
    const fy = hat === "hood" ? 7.4 : 8.8;
    const fcy = hat === "hood" ? 15.2 : 14;
    const fhx = dx / fx;
    const fhy = (gy - fcy) / fy;
    const inFace = fhx * fhx + fhy * fhy <= 1;
    if (inFace) c = S.face;
    if (inFace && hat === "none" && gy < 8.6) c = S.hat;

    if (hat === "wide") {
      if (gy >= 3 && gy <= 7 && gx >= 10 && gx <= 21) c = gy === 7 ? S.band : S.hat;
      if (gy >= 8 && gy <= 9 && gx >= 4 && gx <= 27) c = S.hat;
    }
    if (hat === "cap") {
      if (gy >= 4 && gy <= 8) {
        const inset = gy === 4 ? 2 : gy === 5 ? 1 : 0;
        if (gx >= 9 + inset && gx <= 22 - inset) c = S.hat;
      }
      if (gy === 9 && gx >= 9 && gx <= 27) c = S.hat;
    }

    if (inFace) {
      if (acc === "sunglasses") {
        if (gy >= 12 && gy <= 13 && ((gx >= 9 && gx <= 14) || (gx >= 17 && gx <= 22))) c = "#050505";
        if (gy === 12 && (gx === 15 || gx === 16)) c = "#050505";
        if (gy === 12 && gx === 10 && S.glint) c = S.glint;
      } else if (gy === 13 && (gx === 12 || gx === 19)) {
        c = S.hat;
      }
      if (acc === "mustache") {
        if (gy === 17 && gx >= 11 && gx <= 20) c = S.hat;
        if (gy === 18 && ((gx >= 12 && gx <= 14) || (gx >= 17 && gx <= 19))) c = S.hat;
      }
      if (acc === "bandana" && gy >= 17) c = S.band;
    }
    return c;
  }

  function makeSample(): HTMLCanvasElement {
    const c = document.createElement("canvas");
    c.width = 320;
    c.height = 360;
    const g = c.getContext("2d") as CanvasRenderingContext2D;
    const bgG = g.createLinearGradient(0, 0, 0, 360);
    bgG.addColorStop(0, "#9aa5b1");
    bgG.addColorStop(1, "#3b4652");
    g.fillStyle = bgG;
    g.fillRect(0, 0, 320, 360);
    g.fillStyle = "#222a33";
    g.beginPath();
    g.ellipse(160, 380, 150, 110, 0, 0, Math.PI * 2);
    g.fill();
    g.fillStyle = "#b98a6a";
    g.fillRect(135, 230, 50, 60);
    const rg = g.createRadialGradient(140, 130, 10, 160, 150, 100);
    rg.addColorStop(0, "#f0cfb0");
    rg.addColorStop(1, "#a87455");
    g.fillStyle = rg;
    g.beginPath();
    g.ellipse(160, 150, 70, 88, 0, 0, Math.PI * 2);
    g.fill();
    g.fillStyle = "#1c1410";
    g.beginPath();
    g.ellipse(160, 95, 72, 42, 0, Math.PI, 0);
    g.fill();
    g.fillRect(128, 140, 14, 8);
    g.fillRect(178, 140, 14, 8);
    g.fillRect(138, 200, 44, 9);
    return c;
  }

  function initWantedPoster(root: HTMLElement) {
    const el = <T extends Element>(sel: string): T => root.querySelector<T>(sel) as T;

    const headingIn = el<HTMLInputElement>("[data-heading]");
    const nameIn = el<HTMLInputElement>("[data-name]");
    const aliasIn = el<HTMLInputElement>("[data-alias]");
    const chargeIn = el<HTMLTextAreaElement>("[data-charge]");
    const currencySel = el<HTMLSelectElement>("[data-currency]");
    const rewardIn = el<HTMLInputElement>("[data-reward]");
    const lastIn = el<HTMLInputElement>("[data-last]");
    const footerIn = el<HTMLInputElement>("[data-footer]");
    const fineIn = el<HTMLInputElement>("[data-fine]");
    const hatSel = el<HTMLSelectElement>("[data-hat]");
    const accSel = el<HTMLSelectElement>("[data-acc]");
    const themeSel = el<HTMLSelectElement>("[data-theme]");
    const sizeSel = el<HTMLSelectElement>("[data-size]");
    const blocksIn = el<HTMLInputElement>("[data-blocks]");
    const blocksLabel = el<HTMLElement>("[data-blocks-label]");
    const ditherIn = el<HTMLInputElement>("[data-dither]");
    const fileIn = el<HTMLInputElement>("[data-file]");
    const fileName = el<HTMLElement>("[data-file-name]");
    const dropzone = el<HTMLElement>("[data-dropzone]");
    const sampleBtn = el<HTMLButtonElement>("[data-sample]");
    const silPanel = el<HTMLElement>("[data-silhouette-panel]");
    const photoPanel = el<HTMLElement>("[data-photo-panel]");
    const modeBtns = root.querySelectorAll<HTMLButtonElement>("[data-mode-btn]");
    const downloadBtn = el<HTMLButtonElement>("[data-download]");
    const copyBtn = el<HTMLButtonElement>("[data-copy]");
    const copyIcon = el<SVGElement>("[data-copy-icon]");
    const copyCheck = el<SVGElement>("[data-copy-check]");
    const copyLabel = el<HTMLElement>("[data-copy-label]");
    const resetBtn = el<HTMLButtonElement>("[data-reset]");
    const statusEl = el<HTMLElement>("[data-status]");
    const canvas = el<HTMLCanvasElement>("[data-canvas]");
    const maybeCtx = canvas.getContext("2d");
    if (!maybeCtx) return;
    const ctx: CanvasRenderingContext2D = maybeCtx;

    let mode: "silhouette" | "photo" = "silhouette";
    let photo: CanvasImageSource | null = null;
    let photoW = 0;
    let photoH = 0;
    let raf = 0;

    const ACTIVE = ["bg-orange-600", "text-white"];
    const IDLE = ["bg-white", "text-gray-700", "hover:bg-orange-50"];

    function say(msg: string) {
      statusEl.textContent = msg;
    }

    function setMode(m: "silhouette" | "photo") {
      mode = m;
      modeBtns.forEach((b) => {
        const on = b.dataset.value === m;
        ACTIVE.forEach((c) => b.classList.toggle(c, on));
        IDLE.forEach((c) => b.classList.toggle(c, !on));
      });
      silPanel.classList.toggle("hidden", m !== "silhouette");
      photoPanel.classList.toggle("hidden", m !== "photo");
      schedule();
    }

    function schedule() {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(draw);
    }

    function setFont(px: number, weight: string, family: string, ls: number, italic = false) {
      ctx.font = (italic ? "italic " : "") + weight + " " + px + "px " + family;
      if ("letterSpacing" in ctx) (ctx as any).letterSpacing = ls + "px";
    }

    function fitPx(
      text: string,
      maxW: number,
      start: number,
      min: number,
      weight: string,
      family: string,
      ls: number,
      italic = false,
    ): number {
      let px = Math.floor(start);
      const floor = Math.floor(min);
      while (px > floor) {
        setFont(px, weight, family, ls, italic);
        if (ctx.measureText(text).width <= maxW) return px;
        px -= 1;
      }
      return floor;
    }

    function wrapLines(text: string, maxW: number, maxLines: number): string[] {
      const words = text.trim().split(/\s+/).filter(Boolean);
      const lines: string[] = [];
      let cur = "";
      for (const w of words) {
        const test = cur ? cur + " " + w : w;
        if (ctx.measureText(test).width <= maxW) {
          cur = test;
          continue;
        }
        if (cur) {
          lines.push(cur);
          cur = "";
        }
        if (ctx.measureText(w).width > maxW) {
          let chunk = "";
          for (const ch of Array.from(w)) {
            if (ctx.measureText(chunk + ch).width > maxW) {
              lines.push(chunk);
              chunk = ch;
            } else {
              chunk += ch;
            }
          }
          cur = chunk;
        } else {
          cur = w;
        }
      }
      if (cur) lines.push(cur);
      if (lines.length > maxLines) {
        const kept = lines.slice(0, maxLines);
        let last = kept[maxLines - 1];
        while (last.length > 1 && ctx.measureText(last + "…").width > maxW) last = last.slice(0, -1);
        kept[maxLines - 1] = last.trimEnd() + "…";
        return kept;
      }
      return lines;
    }

    function formatReward(raw: string, cur: string): string {
      const s = raw.trim();
      if (!s) return "";
      const cleaned = s.replace(/,/g, "");
      if (/^\d+(\.\d+)?$/.test(cleaned)) {
        const n = Number(cleaned);
        if (Number.isFinite(n)) return cur + n.toLocaleString("en-US", { maximumFractionDigits: 2 });
      }
      return cur + s;
    }

    function cell(x: number, y: number, w: number, h: number, gx: number, gy: number, gw: number, gh: number) {
      const x0 = Math.round(x + (gx * w) / gw);
      const x1 = Math.round(x + ((gx + 1) * w) / gw);
      const y0 = Math.round(y + (gy * h) / gh);
      const y1 = Math.round(y + ((gy + 1) * h) / gh);
      ctx.fillRect(x0, y0, x1 - x0, y1 - y0);
    }

    function paintBackground(W: number, H: number, u: number, t: Theme, seed: number) {
      const g = ctx.createLinearGradient(0, 0, 0, H);
      g.addColorStop(0, t.bg);
      g.addColorStop(1, t.bg2);
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, W, H);
      const rnd = makeRng(seed);
      if (t.style === "paper") {
        for (let i = 0; i < 2200; i++) {
          const x = rnd() * W;
          const y = rnd() * H;
          const s = (1 + rnd() * 2.5) * u * 0.25;
          ctx.fillStyle = rnd() < 0.5 ? "rgba(43,26,14,0.07)" : "rgba(255,248,220,0.12)";
          ctx.fillRect(x, y, s, s);
        }
        const vg = ctx.createRadialGradient(W / 2, H / 2, Math.min(W, H) * 0.35, W / 2, H / 2, Math.max(W, H) * 0.72);
        vg.addColorStop(0, "rgba(80,50,20,0)");
        vg.addColorStop(1, "rgba(80,50,20,0.28)");
        ctx.fillStyle = vg;
        ctx.fillRect(0, 0, W, H);
      } else if (t.style === "neon") {
        let x = 0;
        while (x < W) {
          const bw = (4 + rnd() * 7) * u;
          const bh = (5 + rnd() * 9) * u;
          ctx.fillStyle = "#120430";
          ctx.fillRect(x, H - bh, bw - 0.4 * u, bh);
          for (let wy = H - bh + 2 * u; wy < H - 2 * u; wy += 3 * u) {
            for (let wx = x + 1.2 * u; wx < x + bw - 2 * u; wx += 2.4 * u) {
              if (rnd() < 0.25) {
                ctx.fillStyle = rnd() < 0.5 ? "rgba(255,46,147,0.35)" : "rgba(46,242,255,0.3)";
                ctx.fillRect(wx, wy, 1 * u, 1.2 * u);
              }
            }
          }
          x += bw;
        }
        ctx.fillStyle = "rgba(255,255,255,0.035)";
        for (let y = 0; y < H; y += 6) ctx.fillRect(0, y, W, 2);
      } else if (t.style === "noir") {
        ctx.strokeStyle = "rgba(255,255,255,0.06)";
        ctx.lineWidth = Math.max(1, u * 0.15);
        for (let i = 0; i < 160; i++) {
          const x = rnd() * W;
          const y = rnd() * H;
          const l = (2 + rnd() * 4) * u;
          ctx.beginPath();
          ctx.moveTo(x, y);
          ctx.lineTo(x - l * 0.35, y + l);
          ctx.stroke();
        }
      }
    }

    function paintFrame(W: number, H: number, u: number, t: Theme) {
      ctx.strokeStyle = t.border;
      ctx.lineWidth = 0.9 * u;
      ctx.strokeRect(3 * u, 3 * u, W - 6 * u, H - 6 * u);
      ctx.lineWidth = 0.3 * u;
      ctx.strokeRect(4.4 * u, 4.4 * u, W - 8.8 * u, H - 8.8 * u);
      ctx.fillStyle = t.border;
      const n = 1.6 * u;
      const right = W - 7.2 * u;
      const bottom = H - 7.2 * u;
      ctx.fillRect(5.6 * u, 5.6 * u, n, n);
      ctx.fillRect(right, 5.6 * u, n, n);
      ctx.fillRect(5.6 * u, bottom, n, n);
      ctx.fillRect(right, bottom, n, n);
    }

    function paintSilhouette(x: number, y: number, w: number, h: number, t: Theme) {
      for (let gy = 0; gy < GRID_H; gy++) {
        for (let gx = 0; gx < GRID_W; gx++) {
          const c = silColor(gx, gy, t.sil, hatSel.value, accSel.value);
          if (c) {
            ctx.fillStyle = c;
            cell(x, y, w, h, gx, gy, GRID_W, GRID_H);
          }
        }
      }
    }

    function paintPhoto(x: number, y: number, w: number, h: number, t: Theme) {
      if (!photo) return;
      const gw = Math.max(16, Math.min(80, parseInt(blocksIn.value, 10) || 48));
      const gh = Math.round((gw * GRID_H) / GRID_W);
      const off = document.createElement("canvas");
      off.width = gw;
      off.height = gh;
      const o = off.getContext("2d", { willReadFrequently: true }) as CanvasRenderingContext2D;
      o.imageSmoothingEnabled = true;
      o.imageSmoothingQuality = "high";
      const target = gw / gh;
      let sw = photoW;
      let sh = photoH;
      let sx = 0;
      let sy = 0;
      if (sw / sh > target) {
        const nw = sh * target;
        sx = (sw - nw) / 2;
        sw = nw;
      } else {
        const nh = sw / target;
        sy = (sh - nh) * 0.2;
        sh = nh;
      }
      o.fillStyle = "#ffffff";
      o.fillRect(0, 0, gw, gh);
      o.drawImage(photo, sx, sy, sw, sh, 0, 0, gw, gh);
      const data = o.getImageData(0, 0, gw, gh).data;
      const dither = ditherIn.checked;
      for (let gy = 0; gy < gh; gy++) {
        for (let gx = 0; gx < gw; gx++) {
          const i = (gy * gw + gx) * 4;
          const lum = 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
          let v = (lum - 128) * 1.2 + 128;
          if (dither) v += (BAYER[(gy % 4) * 4 + (gx % 4)] - 7.5) * 10;
          const level = v < 64 ? 0 : v < 128 ? 1 : v < 192 ? 2 : 3;
          ctx.fillStyle = t.pal[level];
          cell(x, y, w, h, gx, gy, gw, gh);
        }
      }
    }

    function paintPortrait(x: number, y: number, w: number, h: number, u: number, t: Theme) {
      ctx.fillStyle = t.portraitBg;
      ctx.fillRect(x, y, w, h);
      ctx.save();
      ctx.beginPath();
      ctx.rect(x, y, w, h);
      ctx.clip();
      if (mode === "photo" && photo) paintPhoto(x, y, w, h, t);
      else paintSilhouette(x, y, w, h, t);
      if (t.style === "neon") {
        ctx.fillStyle = "rgba(0,0,0,0.18)";
        for (let yy = y; yy < y + h; yy += 4) ctx.fillRect(x, yy, w, 1.5);
      }
      ctx.restore();
      ctx.strokeStyle = t.border;
      ctx.lineWidth = 1 * u;
      ctx.strokeRect(x, y, w, h);
      ctx.lineWidth = 0.3 * u;
      ctx.strokeRect(x - 1.2 * u, y - 1.2 * u, w + 2.4 * u, h + 2.4 * u);
    }

    function draw() {
      const t = THEMES[themeSel.value] || THEMES.west;
      const tall = sizeSel.value === "story";
      const W = tall ? 1080 : 1200;
      const H = tall ? 1920 : 1600;
      if (canvas.width !== W || canvas.height !== H) {
        canvas.width = W;
        canvas.height = H;
      }
      const u = W / 100;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, W, H);

      const name = nameIn.value.trim();
      const alias = aliasIn.value.trim();
      const charge = chargeIn.value.trim();
      const rewardTxt = formatReward(rewardIn.value, currencySel.value);
      const last = lastIn.value.trim();
      const footer = footerIn.value.trim();
      const fine = fineIn.checked;
      const headTxt = (headingIn.value.trim() || "WANTED").toUpperCase();

      paintBackground(W, H, u, t, hashString(name + themeSel.value));
      paintFrame(W, H, u, t);

      const cw = W - 18 * u;
      const cx = W / 2;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";

      // measure charge lines first, because they change the layout
      setFont(4.4 * u, "bold", t.body, 0);
      const chargeLines = charge ? wrapLines(charge.toUpperCase(), cw * 0.95, 3) : [];

      const hH = 12 * u;
      const g1 = 2.5 * u;
      const g2 = 3 * u;
      const nameH = name ? 6.8 * u : 0;
      const aliasH = alias ? 4.8 * u : 0;
      const g3 = chargeLines.length ? 2.2 * u : 0;
      const chargeH = chargeLines.length ? 3.4 * u + chargeLines.length * 4.9 * u : 0;
      const g4 = rewardTxt ? 2.2 * u : 0;
      const rewardH = rewardTxt ? 3.4 * u + 10.5 * u : 0;
      const smallCount = (last ? 1 : 0) + (footer ? 1 : 0) + (fine ? 1 : 0);
      const g5 = smallCount ? 2.2 * u : 0;
      const smallH = (last ? 3.9 * u : 0) + (footer ? 3.6 * u : 0) + (fine ? 3.2 * u : 0);

      const other = hH + g1 + g2 + nameH + aliasH + g3 + chargeH + g4 + rewardH + g5 + smallH;
      const avail = H - 18 * u;
      let ph = avail - other;
      const phMax = (cw * 0.7 * GRID_H) / GRID_W;
      const phMin = 20 * u;
      ph = Math.max(phMin, Math.min(phMax, ph));
      const pw = (ph * GRID_W) / GRID_H;
      const used = other + ph;
      let y = 9 * u + Math.max(0, (avail - used) / 2);

      // heading
      const headPx = fitPx(headTxt, cw * 0.96, 11.5 * u, 4 * u, "bold", t.head, 0.5 * u);
      setFont(headPx, "bold", t.head, 0.5 * u);
      ctx.fillStyle = t.ink;
      ctx.fillText(headTxt, cx, y + hH / 2);
      y += hH;
      ctx.fillStyle = t.accent;
      ctx.fillRect(cx - cw * 0.3, y + g1 * 0.35, cw * 0.6, 0.35 * u);
      y += g1;

      // portrait
      paintPortrait(cx - pw / 2, y, pw, ph, u, t);
      y += ph + g2;

      // name and alias
      if (name) {
        const px = fitPx(name.toUpperCase(), cw * 0.96, 6.8 * u, 3 * u, "bold", t.head, 0.2 * u);
        setFont(px, "bold", t.head, 0.2 * u);
        ctx.fillStyle = t.ink;
        ctx.fillText(name.toUpperCase(), cx, y + nameH / 2);
        y += nameH;
      }
      if (alias) {
        const text = "AKA “" + alias + "”";
        const px = fitPx(text, cw * 0.92, 4.4 * u, 2.4 * u, "normal", t.body, 0, true);
        setFont(px, "normal", t.body, 0, true);
        ctx.fillStyle = t.muted;
        ctx.fillText(text, cx, y + aliasH / 2);
        y += aliasH;
      }
      y += g3;

      // charge
      if (chargeLines.length) {
        setFont(2.6 * u, "bold", t.body, 0.5 * u);
        ctx.fillStyle = t.muted;
        ctx.fillText("WANTED FOR", cx, y + 1.7 * u);
        setFont(4.4 * u, "bold", t.body, 0);
        ctx.fillStyle = t.ink;
        chargeLines.forEach((line, i) => {
          ctx.fillText(line, cx, y + 3.4 * u + i * 4.9 * u + 2.45 * u);
        });
        y += chargeH;
      }
      y += g4;

      // reward
      if (rewardTxt) {
        setFont(2.8 * u, "bold", t.body, 0.8 * u);
        ctx.fillStyle = t.accent;
        ctx.fillText("REWARD", cx, y + 1.7 * u);
        const px = fitPx(rewardTxt, cw * 0.92, 10.5 * u, 4 * u, "bold", t.head, 0.2 * u);
        setFont(px, "bold", t.head, 0.2 * u);
        ctx.fillStyle = t.accent;
        ctx.fillText(rewardTxt, cx, y + 3.4 * u + 5.25 * u);
        y += rewardH;
      }
      y += g5;

      // small lines
      const small = (text: string, size: number, rowH: number, italic: boolean, alpha: number) => {
        const px = fitPx(text, cw, size, 1.8 * u, "normal", t.body, 0.3 * u, italic);
        setFont(px, "normal", t.body, 0.3 * u, italic);
        ctx.globalAlpha = alpha;
        ctx.fillStyle = t.muted;
        ctx.fillText(text, cx, y + rowH / 2);
        ctx.globalAlpha = 1;
        y += rowH;
      };
      if (last) small("LAST SEEN: " + last.toUpperCase(), 3 * u, 3.9 * u, false, 1);
      if (footer) small(footer.toUpperCase(), 2.8 * u, 3.6 * u, false, 1);
      if (fine) small("FICTIONAL POSTER - NOT A REAL NOTICE", 2.4 * u, 3.2 * u, true, 0.85);

      setFont(10, "normal", t.body, 0);
      canvas.setAttribute(
        "aria-label",
        "Wanted poster for " + (name || "an unnamed character") + (charge ? ", wanted for " + charge : "") +
          (rewardTxt ? ". Reward " + rewardTxt : ""),
      );
    }

    function loadFile(file: File | undefined) {
      if (!file) return;
      if (!file.type.startsWith("image/")) {
        say("That file is not an image. Choose a JPG, PNG or WebP photo.");
        return;
      }
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        photo = img;
        photoW = img.naturalWidth;
        photoH = img.naturalHeight;
        fileName.textContent = file.name;
        say("");
        setMode("photo");
        URL.revokeObjectURL(url);
      };
      img.onerror = () => {
        say("That image could not be read. Try a different file.");
        URL.revokeObjectURL(url);
      };
      img.src = url;
    }

    function filenameBase(): string {
      const s = nameIn.value
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
      return "wanted-poster-" + (s || "pixelquil");
    }

    // events
    const liveInputs: HTMLElement[] = [
      headingIn, nameIn, aliasIn, chargeIn, currencySel, rewardIn, lastIn, footerIn,
      fineIn, hatSel, accSel, themeSel, sizeSel, ditherIn,
    ];
    liveInputs.forEach((e) => {
      e.addEventListener("input", schedule);
      e.addEventListener("change", schedule);
    });
    blocksIn.addEventListener("input", () => {
      blocksLabel.textContent = blocksIn.value + " blocks wide";
      schedule();
    });
    modeBtns.forEach((b) =>
      b.addEventListener("click", () => setMode(b.dataset.value === "photo" ? "photo" : "silhouette")),
    );
    fileIn.addEventListener("change", () => loadFile(fileIn.files?.[0]));
    dropzone.addEventListener("dragover", (e) => {
      e.preventDefault();
      dropzone.classList.add("border-orange-400", "bg-orange-50");
    });
    dropzone.addEventListener("dragleave", () => {
      dropzone.classList.remove("border-orange-400", "bg-orange-50");
    });
    dropzone.addEventListener("drop", (e) => {
      e.preventDefault();
      dropzone.classList.remove("border-orange-400", "bg-orange-50");
      loadFile((e as DragEvent).dataTransfer?.files?.[0]);
    });
    sampleBtn.addEventListener("click", () => {
      const s = makeSample();
      photo = s;
      photoW = s.width;
      photoH = s.height;
      fileName.textContent = "Sample portrait";
      say("");
      setMode("photo");
    });

    downloadBtn.addEventListener("click", () => {
      canvas.toBlob((blob) => {
        if (!blob) {
          say("Could not create the image. Try again.");
          return;
        }
        const a = document.createElement("a");
        const url = URL.createObjectURL(blob);
        a.href = url;
        a.download = filenameBase() + ".png";
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }, "image/png");
    });

    copyBtn.addEventListener("click", async () => {
      try {
        const blob = await new Promise<Blob | null>((res) => canvas.toBlob(res, "image/png"));
        if (!blob) throw new Error("no blob");
        await navigator.clipboard.write([new ClipboardItem({ "image/png": blob })]);
        say("");
        copyIcon.classList.add("hidden");
        copyCheck.classList.remove("hidden");
        copyLabel.textContent = "Copied";
        setTimeout(() => {
          copyIcon.classList.remove("hidden");
          copyCheck.classList.add("hidden");
          copyLabel.textContent = "Copy image";
        }, 1500);
      } catch {
        say("Your browser blocked image copy. Use Download PNG instead.");
      }
    });

    resetBtn.addEventListener("click", () => {
      headingIn.value = DEFAULTS.heading;
      nameIn.value = DEFAULTS.name;
      aliasIn.value = DEFAULTS.alias;
      chargeIn.value = DEFAULTS.charge;
      currencySel.value = DEFAULTS.currency;
      rewardIn.value = DEFAULTS.reward;
      lastIn.value = DEFAULTS.last;
      footerIn.value = DEFAULTS.footer;
      fineIn.checked = true;
      hatSel.value = DEFAULTS.hat;
      accSel.value = DEFAULTS.acc;
      themeSel.value = DEFAULTS.theme;
      sizeSel.value = DEFAULTS.size;
      blocksIn.value = DEFAULTS.blocks;
      blocksLabel.textContent = DEFAULTS.blocks + " blocks wide";
      ditherIn.checked = true;
      photo = null;
      fileIn.value = "";
      fileName.textContent = "";
      say("");
      setMode("silhouette");
    });

    setMode("silhouette");
  }

  document.querySelectorAll<HTMLElement>("[data-wanted-poster-maker-widget]").forEach(initWantedPoster);
</script>