
<div data-variant-matrix-widget class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-sm">
  <div class="mb-6">
    <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">1. Product Info</p>
    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">Product title</label>
        <input data-product-title type="text" value="Classic Canvas Tote" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-rose-500 focus:outline-none focus:ring-1 focus:ring-rose-500" />
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">Base SKU prefix</label>
        <input data-sku-prefix type="text" value="TOTE" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-rose-500 focus:outline-none focus:ring-1 focus:ring-rose-500" />
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">Base price ($)</label>
        <input data-base-price type="number" min="0" step="0.01" value="38" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-rose-500 focus:outline-none focus:ring-1 focus:ring-rose-500" />
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">Default inventory qty (per variant)</label>
        <input data-default-inventory type="number" min="0" step="1" value="10" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-rose-500 focus:outline-none focus:ring-1 focus:ring-rose-500" />
      </div>
    </div>
  </div>

  <div class="mb-6">
    <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">2. Options (up to 3 — Shopify's per-product maximum)</p>
    <div data-option-blocks class="space-y-4"></div>
  </div>

  <div class="mb-6">
    <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">3. SKU Pattern</p>
    <div class="flex flex-wrap items-center gap-3">
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">Separator</label>
        <select data-separator class="rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-rose-500 focus:outline-none focus:ring-1 focus:ring-rose-500">
          <option value="-">Dash (-)</option>
          <option value="_">Underscore (_)</option>
          <option value="">None (concatenated)</option>
        </select>
      </div>
      <label class="mt-5 flex items-center gap-2 text-xs text-gray-600">
        <input data-include-index type="checkbox" class="rounded border-gray-300 text-rose-600 focus:ring-rose-500" />
        Append a zero-padded index number to each SKU
      </label>
    </div>
  </div>

  <div>
    <div class="mb-2 flex items-center justify-between">
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">4. Generate &amp; Results</p>
      <button type="button" data-generate-btn class="rounded-lg bg-rose-600 px-4 py-2 text-sm font-medium text-white hover:bg-rose-700">
        Generate Matrix
      </button>
    </div>

    <p data-variant-count class="mb-2 text-sm text-gray-600">&nbsp;</p>
    <p data-limit-warning class="mb-2 hidden rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-700"></p>
    <p data-dup-warning class="mb-2 hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700"></p>

    <div data-results-table-wrap class="max-h-80 overflow-auto rounded-lg border border-gray-200">
      <table class="w-full text-left text-xs">
        <thead class="sticky top-0 bg-gray-50 text-gray-500">
          <tr data-results-head></tr>
        </thead>
        <tbody data-results-body></tbody>
      </table>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-2">
      <button type="button" data-copy-skus-btn class="rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-700 hover:border-rose-300 hover:text-rose-600">
        Copy SKU List
      </button>
      <button type="button" data-download-csv-btn class="rounded-lg bg-rose-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-rose-700">
        Download Shopify CSV
      </button>
    </div>
  </div>
</div>

<script>
  type OptionValue = { value: string; priceMod: number };
  type OptionBlock = { name: string; valuesRaw: string; abbrevLen: number; values: OptionValue[] };
  type ResultRow = { optionValues: string[]; sku: string; price: number };

  const DEFAULT_OPTIONS: { name: string; valuesRaw: string }[] = [
    { name: "Size", valuesRaw: "Small, Medium, Large" },
    { name: "Color", valuesRaw: "Black, Natural" },
    { name: "", valuesRaw: "" },
  ];

  function cleanForSku(s: string): string {
    return s.toUpperCase().replace(/[^A-Z0-9]/g, "");
  }

  function abbreviate(value: string, len: number): string {
    const cleaned = cleanForSku(value);
    return len > 0 ? cleaned.slice(0, len) : cleaned;
  }

  function handleize(s: string): string {
    return s.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
  }

  function initVariantMatrix(root: HTMLElement) {
    const productTitleInput = root.querySelector<HTMLInputElement>("[data-product-title]")!;
    const skuPrefixInput = root.querySelector<HTMLInputElement>("[data-sku-prefix]")!;
    const basePriceInput = root.querySelector<HTMLInputElement>("[data-base-price]")!;
    const defaultInventoryInput = root.querySelector<HTMLInputElement>("[data-default-inventory]")!;
    const optionBlocksWrap = root.querySelector<HTMLElement>("[data-option-blocks]")!;
    const separatorSelect = root.querySelector<HTMLSelectElement>("[data-separator]")!;
    const includeIndexCheckbox = root.querySelector<HTMLInputElement>("[data-include-index]")!;
    const generateBtn = root.querySelector<HTMLButtonElement>("[data-generate-btn]")!;
    const variantCount = root.querySelector<HTMLElement>("[data-variant-count]")!;
    const limitWarning = root.querySelector<HTMLElement>("[data-limit-warning]")!;
    const dupWarning = root.querySelector<HTMLElement>("[data-dup-warning]")!;
    const resultsHead = root.querySelector<HTMLElement>("[data-results-head]")!;
    const resultsBody = root.querySelector<HTMLElement>("[data-results-body]")!;
    const copySkusBtn = root.querySelector<HTMLButtonElement>("[data-copy-skus-btn]")!;
    const downloadCsvBtn = root.querySelector<HTMLButtonElement>("[data-download-csv-btn]")!;

    let optionBlocks: OptionBlock[] = DEFAULT_OPTIONS.map((o) => ({ ...o, abbrevLen: 0, values: [] }));
    let lastResults: ResultRow[] = [];
    let lastActiveOptionNames: string[] = [];

    function parseValues(block: OptionBlock) {
      const names = block.valuesRaw
        .split(",")
        .map((s) => s.trim())
        .filter(Boolean);
      const existing = new Map(block.values.map((v) => [v.value, v.priceMod]));
      block.values = names.map((name) => ({ value: name, priceMod: existing.get(name) ?? 0 }));
    }

    function renderOptionBlocks() {
      optionBlocksWrap.innerHTML = "";
      optionBlocks.forEach((block, i) => {
        const wrap = document.createElement("div");
        wrap.className = "rounded-lg border border-gray-200 p-3";

        const row = document.createElement("div");
        row.className = "mb-2 grid grid-cols-1 gap-2 sm:grid-cols-[1fr_2fr_auto]";

        const nameInput = document.createElement("input");
        nameInput.type = "text";
        nameInput.value = block.name;
        nameInput.placeholder = `Option ${i + 1} name (e.g. Size)`;
        nameInput.className = "rounded-md border border-gray-300 px-2 py-1.5 text-sm focus:border-rose-500 focus:outline-none focus:ring-1 focus:ring-rose-500";
        nameInput.addEventListener("input", () => { block.name = nameInput.value; });

        const valuesInput = document.createElement("input");
        valuesInput.type = "text";
        valuesInput.value = block.valuesRaw;
        valuesInput.placeholder = "Comma-separated values";
        valuesInput.className = "rounded-md border border-gray-300 px-2 py-1.5 text-sm focus:border-rose-500 focus:outline-none focus:ring-1 focus:ring-rose-500";
        valuesInput.addEventListener("input", () => {
          block.valuesRaw = valuesInput.value;
          parseValues(block);
          renderValueChips(chipsWrap, block);
        });

        const abbrevWrap = document.createElement("div");
        abbrevWrap.className = "flex items-center gap-1";
        const abbrevLabel = document.createElement("span");
        abbrevLabel.className = "text-[11px] text-gray-500";
        abbrevLabel.textContent = "SKU chars:";
        const abbrevInput = document.createElement("input");
        abbrevInput.type = "number";
        abbrevInput.min = "0";
        abbrevInput.value = String(block.abbrevLen);
        abbrevInput.title = "How many characters of this option's value to use in the SKU (0 = full value)";
        abbrevInput.className = "w-16 rounded-md border border-gray-300 px-2 py-1.5 text-sm focus:border-rose-500 focus:outline-none focus:ring-1 focus:ring-rose-500";
        abbrevInput.addEventListener("input", () => { block.abbrevLen = parseInt(abbrevInput.value, 10) || 0; });
        abbrevWrap.appendChild(abbrevLabel);
        abbrevWrap.appendChild(abbrevInput);

        row.appendChild(nameInput);
        row.appendChild(valuesInput);
        row.appendChild(abbrevWrap);
        wrap.appendChild(row);

        const chipsWrap = document.createElement("div");
        chipsWrap.className = "flex flex-wrap gap-1.5";
        wrap.appendChild(chipsWrap);

        parseValues(block);
        renderValueChips(chipsWrap, block);

        optionBlocksWrap.appendChild(wrap);
      });
    }

    function renderValueChips(chipsWrap: HTMLElement, block: OptionBlock) {
      chipsWrap.innerHTML = "";
      block.values.forEach((v) => {
        const chip = document.createElement("div");
        chip.className = "flex items-center gap-1 rounded-full border border-gray-200 px-2 py-1 text-[11px] text-gray-600";

        const label = document.createElement("span");
        label.textContent = v.value;
        chip.appendChild(label);

        const priceInput = document.createElement("input");
        priceInput.type = "number";
        priceInput.step = "0.01";
        priceInput.value = String(v.priceMod);
        priceInput.title = `Price modifier for "${v.value}"`;
        priceInput.className = "w-14 rounded border border-gray-200 px-1 py-0.5 text-[11px] focus:border-rose-500 focus:outline-none";
        priceInput.addEventListener("input", () => { v.priceMod = parseFloat(priceInput.value) || 0; });
        chip.appendChild(priceInput);

        chipsWrap.appendChild(chip);
      });
    }

    function activeOptions(): OptionBlock[] {
      return optionBlocks.filter((b) => b.values.length > 0);
    }

    function cartesian(blocks: OptionBlock[]): OptionValue[][] {
      return blocks.reduce<OptionValue[][]>(
        (acc, block) => acc.flatMap((combo) => block.values.map((v) => [...combo, v])),
        [[]]
      );
    }

    function generate() {
      const active = activeOptions();
      lastActiveOptionNames = active.map((b) => b.name || "Option");
      const basePrice = parseFloat(basePriceInput.value) || 0;
      const separator = separatorSelect.value;
      const prefix = cleanForSku(skuPrefixInput.value);

      if (active.length === 0) {
        variantCount.textContent = "Add at least one option with values to generate a matrix.";
        limitWarning.classList.add("hidden");
        dupWarning.classList.add("hidden");
        resultsHead.innerHTML = "";
        resultsBody.innerHTML = "";
        lastResults = [];
        return;
      }

      const combos = cartesian(active);
      const totalDigits = String(combos.length).length;

      const results: ResultRow[] = combos.map((combo, idx) => {
        const skuParts = [prefix, ...combo.map((v, i) => abbreviate(v.value, active[i].abbrevLen))].filter(Boolean);
        if (includeIndexCheckbox.checked) {
          skuParts.push(String(idx + 1).padStart(totalDigits, "0"));
        }
        const sku = skuParts.join(separator);
        const price = basePrice + combo.reduce((sum, v) => sum + v.priceMod, 0);
        return { optionValues: combo.map((v) => v.value), sku, price };
      });

      lastResults = results;

      variantCount.textContent = `${results.length} variant${results.length === 1 ? "" : "s"} across ${active.length} option${active.length === 1 ? "" : "s"}.`;

      if (results.length > 2048) {
        limitWarning.textContent = `${results.length} variants exceeds even Shopify's higher 2,048-variant ceiling — reduce your option values or split this into multiple products.`;
        limitWarning.classList.remove("hidden");
      } else if (results.length > 100) {
        limitWarning.textContent = `${results.length} variants is above the traditional 100-variant cap. Shopify has raised this to 2,048 for eligible stores (rollout has varied by store) — confirm your store supports it before importing this many variants on one product.`;
        limitWarning.classList.remove("hidden");
      } else {
        limitWarning.classList.add("hidden");
      }

      const skuCounts = new Map<string, number>();
      results.forEach((r) => skuCounts.set(r.sku, (skuCounts.get(r.sku) || 0) + 1));
      const hasDupes = [...skuCounts.values()].some((c) => c > 1);
      if (hasDupes) {
        dupWarning.textContent = "Some generated SKUs collide with each other — increase the \"SKU chars\" length for the option(s) causing the overlap.";
        dupWarning.classList.remove("hidden");
      } else {
        dupWarning.classList.add("hidden");
      }

      resultsHead.innerHTML = "";
      [...lastActiveOptionNames, "SKU", "Price"].forEach((h) => {
        const th = document.createElement("th");
        th.className = "px-2 py-1.5 font-medium";
        th.textContent = h;
        resultsHead.appendChild(th);
      });

      resultsBody.innerHTML = "";
      results.forEach((r) => {
        const tr = document.createElement("tr");
        tr.className = skuCounts.get(r.sku)! > 1 ? "border-t border-gray-100 bg-red-50" : "border-t border-gray-100";
        r.optionValues.forEach((v) => {
          const td = document.createElement("td");
          td.className = "px-2 py-1.5";
          td.textContent = v;
          tr.appendChild(td);
        });
        const skuTd = document.createElement("td");
        skuTd.className = "px-2 py-1.5 font-mono";
        skuTd.textContent = r.sku;
        tr.appendChild(skuTd);
        const priceTd = document.createElement("td");
        priceTd.className = "px-2 py-1.5";
        priceTd.textContent = `$${r.price.toFixed(2)}`;
        tr.appendChild(priceTd);
        resultsBody.appendChild(tr);
      });
    }

    generateBtn.addEventListener("click", generate);

    copySkusBtn.addEventListener("click", async () => {
      if (lastResults.length === 0) return;
      try {
        await navigator.clipboard.writeText(lastResults.map((r) => r.sku).join("\n"));
      } catch {
        // ignore
      }
    });

    downloadCsvBtn.addEventListener("click", () => {
      if (lastResults.length === 0) return;
      const handle = handleize(productTitleInput.value) || "product";
      const inventory = defaultInventoryInput.value || "0";

      const header = [
        "Handle",
        "Title",
        ...lastActiveOptionNames.flatMap((_, i) => [`Option${i + 1} Name`, `Option${i + 1} Value`]),
        "Variant SKU",
        "Variant Price",
        "Variant Inventory Qty",
      ];

      const rows = lastResults.map((r, idx) => {
        const row = [
          handle,
          idx === 0 ? productTitleInput.value : "",
          ...lastActiveOptionNames.flatMap((name, i) => [name, r.optionValues[i]]),
          r.sku,
          r.price.toFixed(2),
          inventory,
        ];
        return row.map((cell) => `"${String(cell).replace(/"/g, '""')}"`).join(",");
      });

      const csv = [header.join(","), ...rows].join("\n");
      const blob = new Blob([csv], { type: "text/csv" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `${handle}-variants.csv`;
      a.click();
      URL.revokeObjectURL(url);
    });

    renderOptionBlocks();
    generate();
  }

  document
    .querySelectorAll<HTMLElement>("[data-variant-matrix-widget]")
    .forEach(initVariantMatrix);
</script>