<div data-custom-shipping-rate-table-generator-widget class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-sm">
  <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">1. Basis</p>
  <div class="mt-3 grid gap-4 sm:grid-cols-3">
    <label class="block text-sm text-gray-700">
      Rates are based on
      <select data-basis class="mt-1 w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500">
        <option value="weight">Order weight</option>
        <option value="price">Order price</option>
      </select>
    </label>
    <label data-unit-wrap class="block text-sm text-gray-700">
      Weight unit
      <input data-unit type="text" value="kg" maxlength="8" class="mt-1 w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500" />
    </label>
    <label class="block text-sm text-gray-700">
      Currency symbol
      <input data-symbol type="text" value="$" maxlength="4" class="mt-1 w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500" />
    </label>
  </div>

  <p class="mt-6 text-xs font-semibold uppercase tracking-wide text-gray-400">2. Zones, bands and rates</p>
  <p class="mt-1 text-xs text-gray-500">Edit zone names, band limits and rates right in the table. Enter 0 for free shipping. The last band is open-ended.</p>
  <div data-grid class="mt-3 overflow-x-auto"></div>
  <div class="mt-3 flex flex-wrap items-center gap-2">
    <button type="button" data-add-zone class="rounded-lg border border-gray-200 px-3 py-1.5 text-sm text-gray-700 hover:border-green-500 hover:bg-green-50">+ Add zone</button>
    <button type="button" data-add-tier class="rounded-lg border border-gray-200 px-3 py-1.5 text-sm text-gray-700 hover:border-green-500 hover:bg-green-50">+ Add band</button>
    <button type="button" data-reset class="ml-auto text-sm text-gray-400 hover:text-red-600">Reset to example</button>
  </div>
  <p data-warning class="mt-2 hidden text-xs text-amber-600">Band limits should increase from left to right and be above zero, otherwise the labels will overlap.</p>

  <p class="mt-6 text-xs font-semibold uppercase tracking-wide text-gray-400">3. Free shipping note (optional)</p>
  <label class="mt-3 block text-sm text-gray-700 sm:max-w-xs">
    Free shipping on orders over
    <input data-free-over type="number" min="0" step="any" placeholder="e.g. 75" class="mt-1 w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500" />
  </label>

  <p class="mt-6 text-xs font-semibold uppercase tracking-wide text-gray-400">4. Output</p>
  <div class="mt-3 flex flex-wrap gap-2">
    <button type="button" data-fmt="liquid" class="rounded-full border px-3 py-1 text-sm">Liquid</button>
    <button type="button" data-fmt="html" class="rounded-full border px-3 py-1 text-sm">HTML</button>
    <button type="button" data-fmt="markdown" class="rounded-full border px-3 py-1 text-sm">Markdown</button>
    <button type="button" data-fmt="csv" class="rounded-full border px-3 py-1 text-sm">CSV</button>
  </div>
  <textarea data-output readonly spellcheck="false" class="mt-3 h-64 w-full rounded-lg border border-gray-200 bg-gray-50 p-3 font-mono text-xs text-gray-800 focus:outline-none"></textarea>
  <div class="mt-3 flex flex-wrap items-center gap-2">
    <button type="button" data-copy class="inline-flex items-center gap-1.5 rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700">
      <svg data-copy-icon xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
      <svg data-copy-done xmlns="http://www.w3.org/2000/svg" class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
      <span data-copy-label>Copy</span>
    </button>
    <button type="button" data-download class="rounded-lg border border-gray-200 px-4 py-2 text-sm text-gray-700 hover:border-green-500 hover:bg-green-50">Download CSV</button>
  </div>

  <p class="mt-6 text-xs font-semibold uppercase tracking-wide text-gray-400">Preview</p>
  <div data-preview class="mt-3 overflow-x-auto [&_table]:w-full [&_table]:border-collapse [&_table]:text-sm [&_th]:border [&_th]:border-gray-200 [&_th]:bg-gray-50 [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_th]:font-semibold [&_th]:text-gray-700 [&_td]:border [&_td]:border-gray-200 [&_td]:px-3 [&_td]:py-2 [&_td]:text-gray-700 [&_p]:mt-3 [&_p]:text-sm [&_p]:text-gray-600"></div>
</div>

<script>
  type Zone = { name: string; rates: number[] };

  function initShippingRateTable(root: HTMLElement) {
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel) as T;
    const basisEl = $<HTMLSelectElement>("[data-basis]");
    const unitWrap = $<HTMLElement>("[data-unit-wrap]");
    const unitEl = $<HTMLInputElement>("[data-unit]");
    const symEl = $<HTMLInputElement>("[data-symbol]");
    const grid = $<HTMLElement>("[data-grid]");
    const warning = $<HTMLElement>("[data-warning]");
    const freeEl = $<HTMLInputElement>("[data-free-over]");
    const outEl = $<HTMLTextAreaElement>("[data-output]");
    const previewEl = $<HTMLElement>("[data-preview]");
    const copyBtn = $<HTMLButtonElement>("[data-copy]");
    const copyIcon = $<SVGElement>("[data-copy-icon]");
    const copyDone = $<SVGElement>("[data-copy-done]");
    const copyLabel = $<HTMLElement>("[data-copy-label]");
    const fmtBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-fmt]"));

    const defaults = () => ({
      limits: [0.5, 1, 2],
      zones: [
        { name: "Domestic", rates: [4.5, 6, 8, 12] },
        { name: "Canada", rates: [9, 12, 16, 22] },
        { name: "Europe", rates: [12, 15, 20, 28] },
        { name: "Rest of world", rates: [15, 19, 26, 36] },
      ] as Zone[],
    });

    let { limits, zones } = defaults();
    let fmt: "liquid" | "html" | "markdown" | "csv" = "liquid";

    const inputCls =
      "w-20 rounded-md border border-gray-200 px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-green-500";

    const esc = (s: string) =>
      s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    const liquidSafe = (s: string) => esc(s).replace(/[{}]/g, "");
    const sym = () => symEl.value;
    const unit = () => unitEl.value.trim() || "kg";
    const isWeight = () => basisEl.value === "weight";
    const money = (n: number) => sym() + n.toFixed(2);
    const rateText = (n: number) => (n === 0 ? "Free" : money(n));
    const cents = (n: number) => Math.round(n * 100);
    const freeOver = (): number | null => {
      const v = parseFloat(freeEl.value);
      return isFinite(v) && v > 0 ? v : null;
    };

    function tierLabel(i: number): string {
      const from = i === 0 ? 0 : limits[i - 1];
      const to = i < limits.length ? limits[i] : null;
      if (isWeight()) {
        if (i === 0 && to !== null) return "Up to " + to + " " + unit();
        if (to === null) return "Over " + from + " " + unit();
        return from + "\u2013" + to + " " + unit();
      }
      if (i === 0 && to !== null) return "Under " + sym() + to;
      if (to === null) return sym() + from + " and over";
      return sym() + from + "\u2013" + sym() + to;
    }

    function renderGrid() {
      const nT = limits.length + 1;
      let h = '<table class="min-w-full text-sm"><thead><tr><th class="px-2 py-2 text-left text-xs font-semibold text-gray-500">Zone</th>';
      for (let i = 0; i < nT; i++) {
        h += '<th class="px-2 py-2 text-left align-bottom">';
        if (i < limits.length) {
          h += '<div class="text-[11px] font-normal text-gray-400">' + (isWeight() ? "up to (" + esc(unit()) + ")" : "under (" + esc(sym()) + ")") + "</div>";
          h += '<div class="flex items-center gap-1"><input type="number" min="0" step="any" data-limit="' + i + '" value="' + limits[i] + '" class="' + inputCls + '" />';
        } else {
          h += '<div class="text-[11px] font-normal text-gray-400">last band</div><div class="flex items-center gap-1"><span class="py-1 text-sm text-gray-500">and above</span>';
        }
        if (nT > 2) h += '<button type="button" data-trm="' + i + '" aria-label="Remove band" class="px-1 text-gray-300 hover:text-red-600">\u00d7</button>';
        h += "</div></th>";
      }
      h += '<th class="px-2"></th></tr></thead><tbody>';
      zones.forEach((z, zi) => {
        h += '<tr class="border-t border-gray-100"><td class="px-2 py-1.5"><input type="text" data-zname="' + zi + '" value="' + esc(z.name) + '" class="w-36 rounded-md border border-gray-200 px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-green-500" /></td>';
        for (let i = 0; i < nT; i++) {
          h += '<td class="px-2 py-1.5"><input type="number" min="0" step="any" data-rate="' + zi + "," + i + '" value="' + (z.rates[i] ?? 0) + '" class="' + inputCls + '" /></td>';
        }
        h += '<td class="px-2 py-1.5">' + (zones.length > 1 ? '<button type="button" data-zrm="' + zi + '" aria-label="Remove zone" class="px-1 text-gray-300 hover:text-red-600">\u00d7</button>' : "") + "</td></tr>";
      });
      h += "</tbody></table>";
      grid.innerHTML = h;
    }

    function buildHtml(): string {
      const nT = limits.length + 1;
      let s = '<table class="shipping-rates">\n  <thead>\n    <tr>\n      <th>Zone</th>\n';
      for (let i = 0; i < nT; i++) s += "      <th>" + esc(tierLabel(i)) + "</th>\n";
      s += "    </tr>\n  </thead>\n  <tbody>\n";
      zones.forEach((z) => {
        s += '    <tr>\n      <th scope="row">' + esc(z.name) + "</th>\n";
        for (let i = 0; i < nT; i++) s += "      <td>" + rateText(z.rates[i] ?? 0) + "</td>\n";
        s += "    </tr>\n";
      });
      s += "  </tbody>\n</table>";
      const f = freeOver();
      if (f !== null) s += "\n<p>Free shipping on orders over " + money(f) + ".</p>";
      return s;
    }

    function buildLiquid(): string {
      const nT = limits.length + 1;
      const cell = (n: number) => (n === 0 ? "Free" : "{{ " + cents(n) + " | money }}");
      let s = "{% comment %}\n  Shipping rate table. Paste into a page, section or snippet.\n  Amounts are written in cents and formatted by Shopify's money filter,\n  so they follow your store's currency format.\n{% endcomment %}\n";
      s += '<table class="shipping-rates">\n  <thead>\n    <tr>\n      <th>Zone</th>\n';
      for (let i = 0; i < nT; i++) s += "      <th>" + liquidSafe(tierLabel(i)) + "</th>\n";
      s += "    </tr>\n  </thead>\n  <tbody>\n";
      zones.forEach((z) => {
        s += '    <tr>\n      <th scope="row">' + liquidSafe(z.name) + "</th>\n";
        for (let i = 0; i < nT; i++) s += "      <td>" + cell(z.rates[i] ?? 0) + "</td>\n";
        s += "    </tr>\n";
      });
      s += "  </tbody>\n</table>";
      const f = freeOver();
      if (f !== null) s += "\n<p>Free shipping on orders over {{ " + cents(f) + " | money }}.</p>";
      return s;
    }

    function buildMarkdown(): string {
      const nT = limits.length + 1;
      const c = (t: string) => t.replace(/\|/g, "\\|");
      const head: string[] = ["Zone"];
      for (let i = 0; i < nT; i++) head.push(c(tierLabel(i)));
      let s = "| " + head.join(" | ") + " |\n| " + head.map(() => "---").join(" | ") + " |\n";
      zones.forEach((z) => {
        const row: string[] = [c(z.name)];
        for (let i = 0; i < nT; i++) row.push(rateText(z.rates[i] ?? 0));
        s += "| " + row.join(" | ") + " |\n";
      });
      const f = freeOver();
      if (f !== null) s += "\nFree shipping on orders over " + money(f) + ".";
      return s.trimEnd();
    }

    function buildCsv(): string {
      const nT = limits.length + 1;
      const q = (t: string) => '"' + t.replace(/"/g, '""') + '"';
      const rows: string[] = [];
      const head: string[] = [q("Zone")];
      for (let i = 0; i < nT; i++) head.push(q(tierLabel(i)));
      rows.push(head.join(","));
      zones.forEach((z) => {
        const row: string[] = [q(z.name)];
        for (let i = 0; i < nT; i++) row.push((z.rates[i] ?? 0).toFixed(2));
        rows.push(row.join(","));
      });
      return rows.join("\n");
    }

    function refresh() {
      let ok = limits.every((v, i) => v > 0 && (i === 0 || v > limits[i - 1]));
      warning.classList.toggle("hidden", ok);
      outEl.value = fmt === "liquid" ? buildLiquid() : fmt === "html" ? buildHtml() : fmt === "markdown" ? buildMarkdown() : buildCsv();
      previewEl.innerHTML = buildHtml();
      fmtBtns.forEach((b) => {
        const on = b.dataset.fmt === fmt;
        b.classList.toggle("bg-green-600", on);
        b.classList.toggle("text-white", on);
        b.classList.toggle("border-green-600", on);
        b.classList.toggle("bg-white", !on);
        b.classList.toggle("text-gray-600", !on);
        b.classList.toggle("border-gray-200", !on);
      });
    }

    function syncBasis() {
      unitWrap.classList.toggle("hidden", !isWeight());
      renderGrid();
      refresh();
    }

    grid.addEventListener("input", (e) => {
      const t = e.target as HTMLInputElement;
      if (t.dataset.zname !== undefined) {
        zones[Number(t.dataset.zname)].name = t.value;
      } else if (t.dataset.limit !== undefined) {
        limits[Number(t.dataset.limit)] = parseFloat(t.value) || 0;
      } else if (t.dataset.rate !== undefined) {
        const [z, i] = t.dataset.rate.split(",").map(Number);
        zones[z].rates[i] = Math.max(0, parseFloat(t.value) || 0);
      }
      refresh();
    });

    grid.addEventListener("click", (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>("[data-zrm],[data-trm]");
      if (!t) return;
      if (t.dataset.zrm !== undefined) {
        zones.splice(Number(t.dataset.zrm), 1);
      } else if (t.dataset.trm !== undefined) {
        const i = Number(t.dataset.trm);
        if (limits.length < 1) return;
        zones.forEach((z) => z.rates.splice(i, 1));
        limits.splice(Math.min(i, limits.length - 1), 1);
      }
      renderGrid();
      refresh();
    });

    $<HTMLElement>("[data-add-zone]").addEventListener("click", () => {
      const nT = limits.length + 1;
      const last = zones[zones.length - 1];
      zones.push({ name: "New zone", rates: Array.from({ length: nT }, (_, i) => last?.rates[i] ?? 0) });
      renderGrid();
      refresh();
    });

    $<HTMLElement>("[data-add-tier]").addEventListener("click", () => {
      const lastLimit = limits.length ? limits[limits.length - 1] : 0;
      limits.push(lastLimit > 0 ? Math.round(lastLimit * 2 * 100) / 100 : 1);
      zones.forEach((z) => z.rates.push(z.rates[z.rates.length - 1] ?? 0));
      renderGrid();
      refresh();
    });

    $<HTMLElement>("[data-reset]").addEventListener("click", () => {
      ({ limits, zones } = defaults());
      basisEl.value = "weight";
      unitEl.value = "kg";
      symEl.value = "$";
      freeEl.value = "";
      syncBasis();
    });

    basisEl.addEventListener("change", syncBasis);
    unitEl.addEventListener("input", () => {
      renderGrid();
      refresh();
    });
    symEl.addEventListener("input", () => {
      renderGrid();
      refresh();
    });
    freeEl.addEventListener("input", refresh);

    fmtBtns.forEach((b) =>
      b.addEventListener("click", () => {
        fmt = b.dataset.fmt as typeof fmt;
        refresh();
      }),
    );

    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(outEl.value);
      } catch {
        outEl.select();
        document.execCommand("copy");
      }
      copyIcon.classList.add("hidden");
      copyDone.classList.remove("hidden");
      copyLabel.textContent = "Copied";
      setTimeout(() => {
        copyIcon.classList.remove("hidden");
        copyDone.classList.add("hidden");
        copyLabel.textContent = "Copy";
      }, 1500);
    });

    $<HTMLElement>("[data-download]").addEventListener("click", () => {
      const blob = new Blob([buildCsv()], { type: "text/csv;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "shipping-rates.csv";
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    });

    syncBasis();
  }

  document
    .querySelectorAll<HTMLElement>("[data-custom-shipping-rate-table-generator-widget]")
    .forEach(initShippingRateTable);
</script>