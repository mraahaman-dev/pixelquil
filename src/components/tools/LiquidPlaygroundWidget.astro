    };

    sectionSelect.addEventListener('change', () => {
      const key = sectionSelect.value;
      if (!key || !sections[key]) return;
      const s = sections[key];
      liquidInput.value = s.liquid;
      cssInput.value = s.css || '/* No custom CSS needed \u2014 Tailwind utility classes cover this section. */';
      jsInput.value = s.js || '// No JS needed for this section';
      renderPreview();
    });

    // --- Tabs ---
    const tabBtns = root.querySelectorAll<HTMLButtonElement>('[data-tab-btn]');
    const tabPanels = root.querySelectorAll<HTMLElement>('[data-tab-panel]');
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = btn.dataset.tabBtn;
        tabBtns.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('text-emerald-700', active);
          b.classList.toggle('border-b-2', active);
          b.classList.toggle('border-emerald-600', active);
          b.classList.toggle('bg-white', active);
          b.classList.toggle('text-gray-500', !active);
        });
        tabPanels.forEach((p) => {
          const isMatch = p.dataset.tabPanel === tab;
          p.classList.toggle('hidden', !isMatch);
          p.classList.toggle('block', isMatch);
        });
      });
    });

    // --- Render pipeline ---
    function buildDoc(bodyHtml: string) {
      return `<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<script src="https://cdn.tailwindcss.com"><\/script>
<style>${cssInput.value}</style>
</head>
<body>
${bodyHtml}
<script>${jsInput.value}<\/script>
</body>
</html>`;
    }

    function showError(msg: string) {
      errorBanner.textContent = msg;
      errorBanner.classList.remove('hidden');
    }
    function clearError() {
      errorBanner.classList.add('hidden');
      errorBanner.textContent = '';
    }

    async function renderPreview() {
      let data: unknown;
      try {
        data = JSON.parse(dataInput.value);
      } catch (e) {
        showError('Data JSON error: ' + (e as Error).message);
        return;
      }
      try {
        const html = await engine.parseAndRender(liquidInput.value, data as object);
        preview.srcdoc = buildDoc(html);
        clearError();
      } catch (e) {
        showError('Liquid error: ' + (e as Error).message);
      }
    }

    let debounceTimer: number | undefined;
    function scheduleRun() {
      if (!autoRun.checked) return;
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(renderPreview, 500);
    }
    [liquidInput, cssInput, jsInput, dataInput].forEach((el) => el.addEventListener('input', scheduleRun));
    runBtn.addEventListener('click', renderPreview);

    // --- Copy buttons ---
    const sources: Record<string, HTMLTextAreaElement> = { liquid: liquidInput, css: cssInput, js: jsInput };
    root.querySelectorAll<HTMLButtonElement>('[data-copy-btn]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const key = btn.dataset.copyBtn!;
        await navigator.clipboard.writeText(sources[key].value);
        const label = root.querySelector<HTMLElement>(`[data-copy-label="${key}"]`)!;
        const original = label.textContent;
        label.textContent = 'Copied!';
        window.setTimeout(() => { label.textContent = original; }, 1500);
      });
    });

    // --- Download as .liquid (mirrors real Shopify section file structure) ---
    root.querySelector<HTMLButtonElement>('[data-download-btn]')!.addEventListener('click', () => {
      const bundle = `${liquidInput.value}

<style>
${cssInput.value}
</style>

<script>
${jsInput.value}
<\/script>`;
      const blob = new Blob([bundle], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'section.liquid';
      a.click();
      URL.revokeObjectURL(url);
    });

    // --- Reset ---
    root.querySelector<HTMLButtonElement>('[data-reset-btn]')!.addEventListener('click', () => {
      if (!confirm('Reset all panels, including the mock data, back to the starting point?')) return;
      liquidInput.value = starterLiquid;
      cssInput.value = starterCss;
      jsInput.value = starterJs;
      dataInput.value = starterData;
      sectionSelect.value = '';
      renderPreview();
    });

    renderPreview();
  }

  document.querySelectorAll<HTMLElement>('[data-liquid-playground-widget]').forEach(initLiquidPlayground);
</script>