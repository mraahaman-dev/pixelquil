<div data-pixel-avatar-widget class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-sm">
  <div class="grid gap-8 lg:grid-cols-2">
    <!-- Controls -->
    <div class="space-y-6">
      <section>
        <h4 class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">1. Photo</h4>
        <label data-dropzone class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-gray-300 px-4 py-8 text-center transition hover:border-fuchsia-400 hover:bg-fuchsia-50 focus-within:ring-2 focus-within:ring-fuchsia-500">
          <svg class="h-8 w-8 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18a4 4 0 01-.5-7.97A5.5 5.5 0 0117 8.5 4.5 4.5 0 0117.5 18H7z"/><path d="M12 12v6 M9.5 14.5L12 12l2.5 2.5"/></svg>
          <span class="text-sm font-medium text-gray-700">Drop a photo here or click to choose one</span>
          <span class="text-xs text-gray-400">JPG, PNG or WebP. It never leaves your device.</span>
          <input data-file type="file" accept="image/*" class="sr-only" />
        </label>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <button type="button" data-sample class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 transition hover:bg-gray-50">Try a sample</button>
          <span data-filename class="min-w-0 truncate text-xs text-gray-400"></span>
        </div>
        <p data-error class="mt-2 hidden text-sm text-red-600"></p>
      </section>

      <section>
        <h4 class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">2. Style</h4>
        <div data-styles class="grid grid-cols-2 gap-2 sm:grid-cols-3"></div>
      </section>

      <section>
        <h4 class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">3. Pixel grid</h4>
        <div class="flex flex-wrap gap-2">
          <button type="button" data-grid-btn data-value="16" class="rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-600 transition hover:border-gray-300">16 px</button>
          <button type="button" data-grid-btn data-value="24" class="rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-600 transition hover:border-gray-300">24 px</button>
          <button type="button" data-grid-btn data-value="32" class="rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-600 transition hover:border-gray-300">32 px</button>
          <button type="button" data-grid-btn data-value="48" class="rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-600 transition hover:border-gray-300">48 px</button>
          <button type="button" data-grid-btn data-value="64" class="rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-600 transition hover:border-gray-300">64 px</button>
        </div>
      </section>

      <section>
        <h4 class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">4. Colour mapping</h4>
        <div class="flex flex-wrap gap-2">
          <button type="button" data-mode-btn data-value="tone" class="rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-600 transition hover:border-gray-300">Tone ramp</button>
          <button type="button" data-mode-btn data-value="closest" class="rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-600 transition hover:border-gray-300">Closest colour</button>
        </div>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="text-sm text-gray-600">Dithering</span>
            <select data-dither class="mt-1 w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700 focus:border-fuchsia-500 focus:outline-none focus:ring-2 focus:ring-fuchsia-500">
              <option value="none">None (flat colour)</option>
              <option value="bayer">Bayer 4x4 (ordered)</option>
            </select>
          </label>
          <label class="block">
            <span class="flex justify-between text-sm text-gray-600"><span>Dither strength</span><span data-val-strength class="tabular-nums text-gray-400"></span></span>
            <input data-strength type="range" min="0" max="1" step="0.05" value="0.5" class="mt-3 w-full accent-fuchsia-600" />
          </label>
        </div>
      </section>

      <section>
        <h4 class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">5. Framing and tone</h4>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="flex justify-between text-sm text-gray-600"><span>Zoom</span><span data-val-zoom class="tabular-nums text-gray-400"></span></span>
            <input data-zoom type="range" min="1" max="3" step="0.05" value="1" class="mt-1 w-full accent-fuchsia-600" />
          </label>
          <label class="block">
            <span class="flex justify-between text-sm text-gray-600"><span>Left / right</span><span data-val-panx class="tabular-nums text-gray-400"></span></span>
            <input data-panx type="range" min="-100" max="100" step="1" value="0" class="mt-1 w-full accent-fuchsia-600" />
          </label>
          <label class="block">
            <span class="flex justify-between text-sm text-gray-600"><span>Up / down</span><span data-val-pany class="tabular-nums text-gray-400"></span></span>
            <input data-pany type="range" min="-100" max="100" step="1" value="0" class="mt-1 w-full accent-fuchsia-600" />
          </label>
          <label class="block">
            <span class="flex justify-between text-sm text-gray-600"><span>Brightness</span><span data-val-brightness class="tabular-nums text-gray-400"></span></span>
            <input data-brightness type="range" min="-50" max="50" step="1" value="0" class="mt-1 w-full accent-fuchsia-600" />
          </label>
          <label class="block">
            <span class="flex justify-between text-sm text-gray-600"><span>Contrast</span><span data-val-contrast class="tabular-nums text-gray-400"></span></span>
            <input data-contrast type="range" min="-50" max="50" step="1" value="0" class="mt-1 w-full accent-fuchsia-600" />
          </label>
          <label class="flex items-center gap-2 self-end pb-1 text-sm text-gray-600">
            <input data-circle type="checkbox" class="h-4 w-4 rounded border-gray-300 accent-fuchsia-600" />
            <span>Round avatar (transparent corners)</span>
          </label>
        </div>
      </section>
    </div>

    <!-- Preview -->
    <div class="lg:sticky lg:top-6 lg:self-start">
      <h4 class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">Preview</h4>
      <div class="relative mx-auto aspect-square w-full max-w-[420px] overflow-hidden rounded-xl border border-gray-200 bg-[repeating-conic-gradient(#e5e7eb_0%_25%,#f9fafb_0%_50%)] bg-[length:16px_16px]">
        <canvas data-preview width="256" height="256" class="invisible block h-full w-full"></canvas>
        <div data-placeholder class="absolute inset-0 flex items-center justify-center p-6 text-center text-sm text-gray-400">Add a photo or press Try a sample to see your pixel avatar here.</div>
      </div>
      <div data-swatches class="mx-auto mt-3 flex max-w-[420px] flex-wrap gap-1.5"></div>
      <p data-info class="mx-auto mt-3 max-w-[420px] text-xs text-gray-500"></p>

      <div class="mx-auto mt-4 grid max-w-[420px] gap-3 sm:grid-cols-2 sm:items-end">
        <label class="block">
          <span class="text-sm text-gray-600">Export size</span>
          <select data-export class="mt-1 w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700 focus:border-fuchsia-500 focus:outline-none focus:ring-2 focus:ring-fuchsia-500">
            <option value="0">Actual grid pixels (1x)</option>
            <option value="256">About 256 px</option>
            <option value="512" selected>About 512 px</option>
            <option value="1024">About 1024 px</option>
            <option value="2048">About 2048 px</option>
          </select>
        </label>
        <button type="button" data-download disabled class="inline-flex items-center justify-center gap-2 rounded-lg bg-fuchsia-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-fuchsia-700 focus:outline-none focus:ring-2 focus:ring-fuchsia-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11 M7.5 11L12 15.5 16.5 11 M5 20h14"/></svg>
          Download PNG
        </button>
      </div>
      <div class="mx-auto mt-3 flex max-w-[420px]">
        <button type="button" data-reset class="ml-auto text-xs text-gray-400 hover:text-red-600">Reset settings</button>
      </div>
    </div>
  </div>
</div>

<script>
  type Mode = "tone" | "closest";
  type StyleDef = { id: string; name: string; colors: string[] };
  type Pal = { rgb: number[][]; lab: number[][]; ramp: number[] };

  const STYLES: StyleDef[] = [
    { id: "neon-night", name: "Neon night", colors: ["#0a0820", "#1c1250", "#3b1f7a", "#7b2fd0", "#ff2d95", "#00d9ff", "#7dffd8", "#f3eaff"] },
    { id: "retro-arcade", name: "Retro arcade", colors: ["#101018", "#2a1f4d", "#7a2a4f", "#d4244a", "#f77f1b", "#ffd93b", "#3ec97a", "#2a8fff", "#8a8aa3", "#fff6e0"] },
    { id: "pixel-noir", name: "Pixel noir", colors: ["#08090b", "#17191d", "#2a2e35", "#444a54", "#6b7280", "#9aa3ad", "#c9d0d6", "#f2f4f6"] },
    { id: "sunset-city", name: "Sunset city", colors: ["#1a1033", "#3a1b5c", "#2c3c78", "#6e2a7f", "#5a7fc4", "#b83a7b", "#f2566b", "#ff8c5a", "#ffc46b", "#fff0cf"] },
    { id: "cyber-street", name: "Cyber street", colors: ["#04060c", "#0e1a2b", "#17304c", "#3a3a52", "#1f6d8c", "#00d0ff", "#ff38e6", "#fcee0a", "#6bff7c", "#dfeaff"] },
  ];

  const BAYER4 = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5];

  const ACTIVE = ["border-fuchsia-500", "bg-fuchsia-50", "text-fuchsia-700", "ring-1", "ring-fuchsia-500"];
  const IDLE = ["border-gray-200", "bg-white", "text-gray-600"];

  const DEFAULTS = {
    style: "neon-night",
    grid: 32,
    mode: "tone" as Mode,
    dither: "none",
    strength: 0.5,
    zoom: 1,
    panX: 0,
    panY: 0,
    brightness: 0,
    contrast: 0,
    circle: false,
    exportSize: 512,
  };

  function setActive(btn: HTMLElement, on: boolean) {
    ACTIVE.forEach((c) => btn.classList.toggle(c, on));
    IDLE.forEach((c) => btn.classList.toggle(c, !on));
    btn.setAttribute("aria-pressed", on ? "true" : "false");
  }

  function makeCanvas(w: number, h: number): HTMLCanvasElement {
    const c = document.createElement("canvas");
    c.width = Math.max(1, Math.round(w));
    c.height = Math.max(1, Math.round(h));
    return c;
  }

  function smooth(ctx: CanvasRenderingContext2D) {
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = "high";
  }

  // Crop a rectangle of src and shrink it to dw x dh in halving steps, which averages
  // pixels far better than one big drawImage call.
  function resample(src: CanvasImageSource, sx: number, sy: number, sw: number, sh: number, dw: number, dh: number): HTMLCanvasElement {
    let cw = Math.max(dw, Math.round(sw));
    let ch = Math.max(dh, Math.round(sh));
    let cur = makeCanvas(cw, ch);
    let ctx = cur.getContext("2d")!;
    smooth(ctx);
    ctx.drawImage(src, sx, sy, sw, sh, 0, 0, cw, ch);
    while (cw > dw * 2 || ch > dh * 2) {
      const nw = Math.max(dw, Math.floor(cw / 2));
      const nh = Math.max(dh, Math.floor(ch / 2));
      const next = makeCanvas(nw, nh);
      const nctx = next.getContext("2d")!;
      smooth(nctx);
      nctx.drawImage(cur, 0, 0, cw, ch, 0, 0, nw, nh);
      cur = next;
      cw = nw;
      ch = nh;
    }
    if (cw !== dw || ch !== dh) {
      const last = makeCanvas(dw, dh);
      const lctx = last.getContext("2d")!;
      smooth(lctx);
      lctx.drawImage(cur, 0, 0, cw, ch, 0, 0, dw, dh);
      cur = last;
    }
    return cur;
  }

  function srgbToLinear(v: number): number {
    const c = v / 255;
    return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
  }

  function toOklab(r: number, g: number, b: number): number[] {
    const lr = srgbToLinear(r);
    const lg = srgbToLinear(g);
    const lb = srgbToLinear(b);
    const l = Math.cbrt(0.4122214708 * lr + 0.5363325363 * lg + 0.0514459929 * lb);
    const m = Math.cbrt(0.2119034982 * lr + 0.6806995451 * lg + 0.1073969566 * lb);
    const s = Math.cbrt(0.0883024619 * lr + 0.2817188376 * lg + 0.6299787005 * lb);
    return [
      0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s,
      1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s,
      0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s,
    ];
  }

  function hexToRgb(hex: string): number[] {
    const n = parseInt(hex.slice(1), 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }

  function buildPalette(hexes: string[]): Pal {
    const rgb = hexes.map(hexToRgb);
    const lab = rgb.map((c) => toOklab(c[0], c[1], c[2]));
    const ramp = lab.map((_, i) => i).sort((a, b) => lab[a][0] - lab[b][0]);
    return { rgb, lab, ramp };
  }

  function clamp(v: number, lo: number, hi: number): number {
    return Math.min(hi, Math.max(lo, v));
  }

  function drawScaled(target: HTMLCanvasElement, small: HTMLCanvasElement, scale: number) {
    target.width = small.width * scale;
    target.height = small.height * scale;
    const ctx = target.getContext("2d")!;
    ctx.imageSmoothingEnabled = false;
    ctx.clearRect(0, 0, target.width, target.height);
    ctx.drawImage(small, 0, 0, target.width, target.height);
  }

  function drawSample(): HTMLCanvasElement {
    const c = makeCanvas(640, 640);
    const g = c.getContext("2d")!;
    const bg = g.createLinearGradient(0, 0, 0, 640);
    bg.addColorStop(0, "#7ec8ff");
    bg.addColorStop(1, "#ffd8a8");
    g.fillStyle = bg;
    g.fillRect(0, 0, 640, 640);
    g.fillStyle = "#3b5bdb";
    g.beginPath();
    g.ellipse(320, 670, 240, 180, 0, 0, Math.PI * 2);
    g.fill();
    g.fillStyle = "#d9a07a";
    g.fillRect(285, 430, 70, 90);
    g.fillStyle = "#f0b896";
    g.beginPath();
    g.ellipse(320, 305, 120, 145, 0, 0, Math.PI * 2);
    g.fill();
    g.fillStyle = "#3a2a20";
    g.beginPath();
    g.ellipse(320, 250, 128, 120, 0, Math.PI, Math.PI * 2);
    g.fill();
    g.fillStyle = "#222222";
    g.beginPath();
    g.ellipse(282, 310, 10, 14, 0, 0, Math.PI * 2);
    g.ellipse(358, 310, 10, 14, 0, 0, Math.PI * 2);
    g.fill();
    g.strokeStyle = "#8a3b3b";
    g.lineWidth = 8;
    g.lineCap = "round";
    g.beginPath();
    g.arc(320, 355, 38, 0.15 * Math.PI, 0.85 * Math.PI);
    g.stroke();
    return c;
  }

  function initPixelAvatar(root: HTMLElement) {
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

    const dropzone = q<HTMLElement>("[data-dropzone]");
    const fileInput = q<HTMLInputElement>("[data-file]");
    const sampleBtn = q<HTMLButtonElement>("[data-sample]");
    const filenameEl = q<HTMLElement>("[data-filename]");
    const errorEl = q<HTMLElement>("[data-error]");
    const stylesEl = q<HTMLElement>("[data-styles]");
    const gridBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-grid-btn]"));
    const modeBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-mode-btn]"));
    const ditherSel = q<HTMLSelectElement>("[data-dither]");
    const strengthIn = q<HTMLInputElement>("[data-strength]");
    const zoomIn = q<HTMLInputElement>("[data-zoom]");
    const panXIn = q<HTMLInputElement>("[data-panx]");
    const panYIn = q<HTMLInputElement>("[data-pany]");
    const brightIn = q<HTMLInputElement>("[data-brightness]");
    const contrastIn = q<HTMLInputElement>("[data-contrast]");
    const circleIn = q<HTMLInputElement>("[data-circle]");
    const exportSel = q<HTMLSelectElement>("[data-export]");
    const canvas = q<HTMLCanvasElement>("[data-preview]");
    const placeholder = q<HTMLElement>("[data-placeholder]");
    const swatchesEl = q<HTMLElement>("[data-swatches]");
    const infoEl = q<HTMLElement>("[data-info]");
    const downloadBtn = q<HTMLButtonElement>("[data-download]");
    const resetBtn = q<HTMLButtonElement>("[data-reset]");

    const valLabels: Record<string, HTMLElement> = {
      strength: q<HTMLElement>("[data-val-strength]"),
      zoom: q<HTMLElement>("[data-val-zoom]"),
      panX: q<HTMLElement>("[data-val-panx]"),
      panY: q<HTMLElement>("[data-val-pany]"),
      brightness: q<HTMLElement>("[data-val-brightness]"),
      contrast: q<HTMLElement>("[data-val-contrast]"),
    };

    const state = { ...DEFAULTS };
    let src: HTMLCanvasElement | null = null;
    let lastPx: HTMLCanvasElement | null = null;
    let raf = 0;

    const palettes = new Map<string, Pal>();
    STYLES.forEach((s) => palettes.set(s.id, buildPalette(s.colors)));
    const styleBtns: HTMLButtonElement[] = [];

    STYLES.forEach((s) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.dataset.value = s.id;
      btn.className = "rounded-lg border px-3 py-2 text-left text-sm font-medium transition hover:border-gray-300";
      const name = document.createElement("span");
      name.className = "block";
      name.textContent = s.name;
      const strip = document.createElement("span");
      strip.className = "mt-1.5 flex h-2 overflow-hidden rounded-sm";
      s.colors.forEach((hex) => {
        const sw = document.createElement("span");
        sw.className = "h-full flex-1";
        sw.style.backgroundColor = hex;
        strip.appendChild(sw);
      });
      btn.appendChild(name);
      btn.appendChild(strip);
      btn.addEventListener("click", () => {
        state.style = s.id;
        syncControls();
        schedule();
      });
      stylesEl.appendChild(btn);
      styleBtns.push(btn);
    });

    function showError(msg: string) {
      errorEl.textContent = msg;
      errorEl.classList.toggle("hidden", !msg);
    }

    function schedule() {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(render);
    }

    function exportScale(grid: number): number {
      return state.exportSize === 0 ? 1 : Math.max(1, Math.round(state.exportSize / grid));
    }

    function syncControls() {
      styleBtns.forEach((b) => setActive(b, b.dataset.value === state.style));
      gridBtns.forEach((b) => setActive(b, Number(b.dataset.value) === state.grid));
      modeBtns.forEach((b) => setActive(b, b.dataset.value === state.mode));
      ditherSel.value = state.dither;
      strengthIn.value = String(state.strength);
      strengthIn.disabled = state.dither === "none";
      strengthIn.classList.toggle("opacity-40", state.dither === "none");
      zoomIn.value = String(state.zoom);
      panXIn.value = String(state.panX);
      panYIn.value = String(state.panY);
      brightIn.value = String(state.brightness);
      contrastIn.value = String(state.contrast);
      circleIn.checked = state.circle;
      exportSel.value = String(state.exportSize);
      valLabels.strength.textContent = Math.round(state.strength * 100) + "%";
      valLabels.zoom.textContent = state.zoom.toFixed(2) + "x";
      valLabels.panX.textContent = String(state.panX);
      valLabels.panY.textContent = String(state.panY);
      valLabels.brightness.textContent = String(state.brightness);
      valLabels.contrast.textContent = String(state.contrast);

      const style = STYLES.find((s) => s.id === state.style) || STYLES[0];
      swatchesEl.textContent = "";
      style.colors.forEach((hex) => {
        const sw = document.createElement("span");
        sw.className = "h-6 w-6 rounded border border-gray-200";
        sw.style.backgroundColor = hex;
        sw.title = hex;
        swatchesEl.appendChild(sw);
      });
    }

    function render() {
      if (!src) {
        placeholder.classList.remove("hidden");
        canvas.classList.add("invisible");
        downloadBtn.disabled = true;
        infoEl.textContent = "";
        lastPx = null;
        return;
      }
      placeholder.classList.add("hidden");
      canvas.classList.remove("invisible");
      downloadBtn.disabled = false;

      const N = state.grid;
      const style = STYLES.find((s) => s.id === state.style) || STYLES[0];
      const pal = palettes.get(style.id)!;
      const n = pal.rgb.length;

      const w = src.width;
      const h = src.height;
      const side = Math.min(w, h) / state.zoom;
      const maxX = w - side;
      const maxY = h - side;
      const sx = maxX / 2 + (state.panX / 100) * (maxX / 2);
      const sy = maxY / 2 + (state.panY / 100) * (maxY / 2);

      const small = resample(src, sx, sy, side, side, N, N);
      const data = small.getContext("2d")!.getImageData(0, 0, N, N).data;

      const contrastF = 1 + state.contrast / 100;
      const bOff = state.brightness * 2.55;
      const adj = (v: number) => clamp((v - 128) * contrastF + 128 + bOff, 0, 255);

      const half = N / 2;
      const inside = (x: number, y: number) => {
        if (!state.circle) return true;
        const dx = x + 0.5 - half;
        const dy = y + 0.5 - half;
        return dx * dx + dy * dy <= half * half;
      };

      const labs: number[][] = new Array(N * N);
      const lumas: number[] = [];
      for (let y = 0; y < N; y++) {
        for (let x = 0; x < N; x++) {
          const i = y * N + x;
          const lab = toOklab(adj(data[i * 4]), adj(data[i * 4 + 1]), adj(data[i * 4 + 2]));
          labs[i] = lab;
          if (inside(x, y)) lumas.push(lab[0]);
        }
      }

      let lo = 0;
      let hi = 1;
      if (state.mode === "tone" && lumas.length) {
        lumas.sort((a, b) => a - b);
        lo = lumas[Math.floor(0.02 * (lumas.length - 1))];
        hi = lumas[Math.ceil(0.98 * (lumas.length - 1))];
        if (hi - lo < 0.0001) hi = lo + 0.0001;
      }

      const useDither = state.dither === "bayer";
      const out = new ImageData(N, N);
      for (let y = 0; y < N; y++) {
        for (let x = 0; x < N; x++) {
          const i = y * N + x;
          const o = i * 4;
          if (!inside(x, y)) {
            out.data[o + 3] = 0;
            continue;
          }
          const bias = useDither ? ((BAYER4[(y % 4) * 4 + (x % 4)] + 0.5) / 16 - 0.5) * state.strength : 0;
          const lab = labs[i];
          let pick = 0;
          if (state.mode === "tone") {
            const t = clamp((lab[0] - lo) / (hi - lo), 0, 1);
            const pos = t * (n - 1) + bias;
            pick = pal.ramp[clamp(Math.round(pos), 0, n - 1)];
          } else {
            const L = lab[0] + bias * 0.35;
            let best = Infinity;
            for (let k = 0; k < n; k++) {
              const dl = L - pal.lab[k][0];
              const da = lab[1] - pal.lab[k][1];
              const db = lab[2] - pal.lab[k][2];
              const d = dl * dl + da * da + db * db;
              if (d < best) {
                best = d;
                pick = k;
              }
            }
          }
          out.data[o] = pal.rgb[pick][0];
          out.data[o + 1] = pal.rgb[pick][1];
          out.data[o + 2] = pal.rgb[pick][2];
          out.data[o + 3] = 255;
        }
      }

      const px = makeCanvas(N, N);
      px.getContext("2d")!.putImageData(out, 0, 0);
      lastPx = px;

      drawScaled(canvas, px, Math.max(1, Math.ceil(512 / N)));

      const scale = exportScale(N);
      const size = N * scale;
      infoEl.textContent = N + " x " + N + " grid, " + n + " colours. Export: " + size + " x " + size + " px (" + scale + "x scale).";
    }

    function setSource(img: CanvasImageSource, w: number, h: number) {
      if (!w || !h) {
        showError("That image has no readable size. Try a JPG or PNG.");
        return;
      }
      const k = Math.min(1, 1024 / Math.max(w, h));
      const dw = Math.max(1, Math.round(w * k));
      const dh = Math.max(1, Math.round(h * k));
      const shrunk = resample(img, 0, 0, w, h, dw, dh);
      const c = makeCanvas(dw, dh);
      const g = c.getContext("2d")!;
      g.fillStyle = "#ffffff";
      g.fillRect(0, 0, dw, dh);
      g.drawImage(shrunk, 0, 0);
      src = c;
      showError("");
      schedule();
    }

    function loadFile(file: File) {
      showError("");
      if (!file.type.startsWith("image/")) {
        showError("That file is not an image. Choose a JPG, PNG or WebP.");
        return;
      }
      if (file.size > 30 * 1024 * 1024) {
        showError("That image is over 30 MB. Resize it first and try again.");
        return;
      }
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        URL.revokeObjectURL(url);
        filenameEl.textContent = file.name;
        setSource(img, img.naturalWidth, img.naturalHeight);
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        showError("Your browser could not read that image. If it is a HEIC photo, export it as JPG or PNG first.");
      };
      img.src = url;
    }

    fileInput.addEventListener("change", () => {
      const f = fileInput.files && fileInput.files[0];
      if (f) loadFile(f);
      fileInput.value = "";
    });
    dropzone.addEventListener("dragover", (e) => {
      e.preventDefault();
      dropzone.classList.add("border-fuchsia-400", "bg-fuchsia-50");
    });
    dropzone.addEventListener("dragleave", () => {
      dropzone.classList.remove("border-fuchsia-400", "bg-fuchsia-50");
    });
    dropzone.addEventListener("drop", (e) => {
      e.preventDefault();
      dropzone.classList.remove("border-fuchsia-400", "bg-fuchsia-50");
      const f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
      if (f) loadFile(f);
    });
    sampleBtn.addEventListener("click", () => {
      filenameEl.textContent = "Sample portrait";
      setSource(drawSample(), 640, 640);
    });

    gridBtns.forEach((b) =>
      b.addEventListener("click", () => {
        state.grid = Number(b.dataset.value);
        syncControls();
        schedule();
      })
    );
    modeBtns.forEach((b) =>
      b.addEventListener("click", () => {
        state.mode = b.dataset.value as Mode;
        syncControls();
        schedule();
      })
    );
    ditherSel.addEventListener("change", () => {
      state.dither = ditherSel.value;
      syncControls();
      schedule();
    });
    exportSel.addEventListener("change", () => {
      state.exportSize = Number(exportSel.value);
      syncControls();
      schedule();
    });
    circleIn.addEventListener("change", () => {
      state.circle = circleIn.checked;
      schedule();
    });

    const bindRange = (el: HTMLInputElement, key: "strength" | "zoom" | "panX" | "panY" | "brightness" | "contrast") => {
      el.addEventListener("input", () => {
        state[key] = Number(el.value);
        syncControls();
        schedule();
      });
    };
    bindRange(strengthIn, "strength");
    bindRange(zoomIn, "zoom");
    bindRange(panXIn, "panX");
    bindRange(panYIn, "panY");
    bindRange(brightIn, "brightness");
    bindRange(contrastIn, "contrast");

    downloadBtn.addEventListener("click", () => {
      if (!lastPx) return;
      const out = makeCanvas(1, 1);
      drawScaled(out, lastPx, exportScale(lastPx.width));
      const name = "pixel-avatar-" + state.style + "-" + lastPx.width + "px.png";
      out.toBlob((blob) => {
        if (!blob) return;
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = name;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }, "image/png");
    });

    resetBtn.addEventListener("click", () => {
      Object.assign(state, DEFAULTS);
      syncControls();
      schedule();
    });

    syncControls();
    render();
  }

  document.querySelectorAll<HTMLElement>("[data-pixel-avatar-widget]").forEach(initPixelAvatar);
</script>