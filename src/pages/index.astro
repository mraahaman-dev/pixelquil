---
import MainLayout from '../layouts/MainLayout.astro';
import HeroVisual from '../components/home/HeroVisual.astro';
import FeatureShowcase from '../components/home/FeatureShowcase.astro';
import RecentTools from '../components/home/RecentTools.astro';
import WhyChooseUs from '../components/home/WhyChooseUs.astro';
import UseCases from '../components/home/UseCases.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import allToolsData from '../data/tools.json';

const tools = [
  {
    title: "SVG Viewer & Validator",
    description: "Preview any SVG and catch invalid markup before you ship it.",
    href: "/svg-tools/svg-viewer/",
    badgeColor: "blue",
    iconPath: "M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z M12 15a3 3 0 100-6 3 3 0 000 6z",
  },
  {
    title: "SVG Code Editor",
    description: "Edit, validate and pretty-print SVG code in real time.",
    href: "/svg-tools/svg-editor/",
    badgeColor: "indigo",
    iconPath: "M8 6L2 12l6 6 M16 6l6 6-6 6",
  },
  {
    title: "SVG ViewBox Fixer",
    description: "Fix missing or broken viewBox attributes automatically.",
    href: "/svg-tools/viewbox-fixer/",
    badgeColor: "purple",
    iconPath: "M4 4h16v16H4z M4 9h16 M9 4v16",
  },
  {
    title: "SVG Palette Extractor",
    description: "Extract beautiful color palettes from any SVG image.",
    href: "/svg-tools/palette-extractor/",
    badgeColor: "amber",
    iconPath: "M12 2a10 10 0 100 20 2 2 0 001-3.73A2 2 0 0114 16a2 2 0 012-2h1.5a3.5 3.5 0 003.5-3.5C21 6 17 2 12 2z M7.5 12a1.5 1.5 0 100-3 1.5 1.5 0 000 3z M9.5 8a1.5 1.5 0 100-3 1.5 1.5 0 000 3z M14.5 7.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3z",
  },
  {
    title: "SVG to CSS Data URI",
    description: "Convert SVGs into inline CSS-ready data URIs instantly.",
    href: "/developer-tools/svg-to-css-data-uri/",
    badgeColor: "teal",
    iconPath: "M4 4l4 4-4 4 M20 20l-4-4 4-4 M13 4l-2 16",
  },
  {
    title: "Image to Tailwind Palette",
    description: "Turn any image into a ready-to-use Tailwind color palette.",
    href: "/developer-tools/image-to-tailwind-palette/",
    badgeColor: "green",
    iconPath: "M3 3h18v18H3z M8.5 9a1.5 1.5 0 100-3 1.5 1.5 0 000 3z M21 15l-5-5L5 21",
  },
];

const categories = [
  {
    title: "SVG & Design Tools",
    description: "Edit, optimize, convert and inspect SVG files.",
    href: "/svg-tools/",
    badgeColor: "teal",
    iconPath: "M12 19l7-7 3 3-7 7-3-3z M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z M2 2l7.586 7.586 M11 13a2 2 0 104 0 2 2 0 00-4 0z",
  },
  {
    title: "Developer Utilities",
    description: "Generate configs, minify code, and speed up workflows.",
    href: "/developer-tools/",
    badgeColor: "purple",
    iconPath: "M8 6L2 12l6 6 M16 6l6 6-6 6",
  },
  {
    title: "Technical SEO Tools",
    description: "Check metadata, redirects, robots.txt and more.",
    href: "/seo-tools/",
    badgeColor: "green",
    iconPath: "M11 19a8 8 0 100-16 8 8 0 000 16z M21 21l-4.35-4.35",
  },
  {
    title: "Shopify Tools",
    description: "Practice Shopify Liquid and theme development in your browser.",
    href: "/shopify-tools/",
    badgeColor: "emerald",
    iconPath: "M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z M3 6h18 M16 10a4 4 0 01-8 0",
  },
];

// Literal class names only (Tailwind v4 needs them written out in full).
// tile = icon box, glow = soft blurred color in the corner, mark = big faint watermark icon
const tones: Record<string, { tile: string; glow: string; mark: string }> = {
  blue: { tile: "bg-blue-50 text-blue-600 ring-blue-100", glow: "bg-blue-200/60", mark: "text-blue-600" },
  indigo: { tile: "bg-indigo-50 text-indigo-600 ring-indigo-100", glow: "bg-indigo-200/60", mark: "text-indigo-600" },
  purple: { tile: "bg-purple-50 text-purple-600 ring-purple-100", glow: "bg-purple-200/60", mark: "text-purple-600" },
  amber: { tile: "bg-amber-50 text-amber-600 ring-amber-100", glow: "bg-amber-200/60", mark: "text-amber-600" },
  teal: { tile: "bg-teal-50 text-teal-600 ring-teal-100", glow: "bg-teal-200/60", mark: "text-teal-600" },
  green: { tile: "bg-green-50 text-green-600 ring-green-100", glow: "bg-green-200/60", mark: "text-green-600" },
  emerald: { tile: "bg-emerald-50 text-emerald-600 ring-emerald-100", glow: "bg-emerald-200/60", mark: "text-emerald-600" },
  cyan: { tile: "bg-cyan-50 text-cyan-600 ring-cyan-100", glow: "bg-cyan-200/60", mark: "text-cyan-600" },
  red: { tile: "bg-red-50 text-red-600 ring-red-100", glow: "bg-red-200/60", mark: "text-red-600" },
  rose: { tile: "bg-rose-50 text-rose-600 ring-rose-100", glow: "bg-rose-200/60", mark: "text-rose-600" },
  lime: { tile: "bg-lime-50 text-lime-600 ring-lime-100", glow: "bg-lime-200/60", mark: "text-lime-600" },
};
const fallbackTone = { tile: "bg-slate-50 text-slate-600 ring-slate-100", glow: "bg-slate-200/60", mark: "text-slate-600" };
const toneFor = (c: string) => tones[c] ?? fallbackTone;

const allTools: any[] = allToolsData as any[];
const toolCount = allTools.length;
const countFor = (href: string) => allTools.filter((t) => `/${t.category}/` === href).length;

// Dot grid for the bottom right corner of each card
const dotGrid =
  "background-image: radial-gradient(rgba(15,23,42,0.16) 1px, transparent 1.2px); background-size: 12px 12px; mask-image: radial-gradient(circle at 100% 100%, black 0%, transparent 70%); -webkit-mask-image: radial-gradient(circle at 100% 100%, black 0%, transparent 70%);";
---

<MainLayout>

  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[620px] bg-gradient-to-b from-indigo-50/80 via-white to-white"></div>
    <div class="pointer-events-none absolute left-1/2 top-[-160px] -z-10 h-[460px] w-[900px] -translate-x-1/2 rounded-full bg-gradient-to-r from-purple-200/50 via-indigo-200/40 to-cyan-200/50 blur-3xl"></div>
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      style="background-image: linear-gradient(to right, rgba(15,23,42,0.045) 1px, transparent 1px), linear-gradient(to bottom, rgba(15,23,42,0.045) 1px, transparent 1px); background-size: 48px 48px; mask-image: radial-gradient(ellipse 75% 60% at 50% 0%, black 25%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 75% 60% at 50% 0%, black 25%, transparent 75%);"
    ></div>

    <div class="mx-auto max-w-6xl px-4 pb-28 pt-16 sm:pt-24">
      <div class="grid items-center gap-14 lg:grid-cols-2">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/80 px-3.5 py-1.5 text-xs font-medium text-slate-600 shadow-sm backdrop-blur">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            Powerful web tools. Zero installs.
          </span>

          <h1 class="mt-6 text-4xl font-bold tracking-tight text-slate-900 sm:text-6xl">
            Edit SVGs. Build Faster.
            <span class="bg-gradient-to-r from-brand-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent"> Fix Technical SEO.</span>
          </h1>

          <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">
            A privacy first toolkit for designers, developers, and website owners. Edit SVG files, generate website configs, and run technical SEO checks, right in your browser.
          </p>

          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a
              href="/svg-tools/svg-editor/"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-slate-900/10 transition hover:bg-slate-800"
            >
              Try SVG Editor
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
            </a>
            <a
              href="/tools/"
              class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50"
            >
              Explore All Tools
            </a>
          </div>

          <ul class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-slate-500">
            <li class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
              No signup for basic tools
            </li>
            <li class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
              Browser based
            </li>
            <li class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
              Fast exports
            </li>
          </ul>
        </div>

        <div class="relative">
          <div class="pointer-events-none absolute -inset-6 -z-10 rounded-[2rem] bg-gradient-to-tr from-indigo-200/50 via-purple-200/40 to-cyan-200/50 blur-2xl"></div>
          <HeroVisual />
        </div>
      </div>
    </div>
  </section>

  <!-- Stats strip -->
  <section class="relative z-10 mx-auto -mt-12 max-w-5xl px-4">
    <dl class="grid grid-cols-2 divide-slate-200 rounded-2xl border border-slate-200 bg-white shadow-xl shadow-slate-900/5 sm:grid-cols-4 sm:divide-x">
      <div class="px-6 py-6 text-center">
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-400">Free tools</dt>
        <dd class="mt-1 text-3xl font-bold text-slate-900">{toolCount}</dd>
      </div>
      <div class="px-6 py-6 text-center">
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-400">Categories</dt>
        <dd class="mt-1 text-3xl font-bold text-slate-900">{categories.length}</dd>
      </div>
      <div class="px-6 py-6 text-center">
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-400">Files uploaded</dt>
        <dd class="mt-1 text-3xl font-bold text-slate-900">0</dd>
      </div>
      <div class="px-6 py-6 text-center">
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-400">Accounts needed</dt>
        <dd class="mt-1 text-3xl font-bold text-slate-900">0</dd>
      </div>
    </dl>
  </section>

  <!-- Explore by Category -->
  <section class="mx-auto max-w-6xl px-4 pb-16 pt-24">
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <span class="text-xs font-semibold uppercase tracking-wider text-brand-600">
        By category
      </span>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Explore the toolkit
      </h2>
      <p class="mt-3 text-slate-600">
        Every tool runs client-side, nothing you upload ever leaves your browser.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {categories.map((category) => (
        <a
          href={category.href}
          class="group relative isolate flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-slate-300 hover:shadow-xl hover:shadow-slate-900/5"
        >
          <!-- Background decoration -->
          <div class={`pointer-events-none absolute -right-8 -top-8 -z-10 h-36 w-36 rounded-full opacity-40 blur-2xl transition-opacity duration-300 group-hover:opacity-100 ${toneFor(category.badgeColor).glow}`}></div>
          <svg
            class={`pointer-events-none absolute -right-3 -top-3 -z-10 h-24 w-24 rotate-12 opacity-[0.09] transition duration-300 ease-out group-hover:rotate-0 group-hover:opacity-[0.16] ${toneFor(category.badgeColor).mark}`}
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          >
            <path d={category.iconPath} />
          </svg>
          <div class="pointer-events-none absolute bottom-0 right-0 -z-10 h-28 w-40 opacity-70" style={dotGrid}></div>

          <span class={`inline-flex h-12 w-12 items-center justify-center rounded-xl ring-1 transition-transform duration-300 group-hover:scale-110 ${toneFor(category.badgeColor).tile}`}>
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d={category.iconPath} />
            </svg>
          </span>
          <h3 class="mt-5 text-lg font-semibold text-slate-900">{category.title}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{category.description}</p>
          <div class="mt-5 flex items-center justify-between text-sm">
            <span class="font-medium text-slate-400">{countFor(category.href)} tools</span>
            <span class="inline-flex items-center gap-1 font-semibold text-slate-900 transition-all group-hover:gap-2">
              Open
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Popular Tools -->
  <section class="border-y border-slate-100 bg-slate-50/60">
    <div class="mx-auto max-w-6xl px-4 py-24">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-xl">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-600">
            Launch batch
          </span>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
            Popular tools
          </h2>
          <p class="mt-3 text-slate-600">
            Six tools to start with, and more added as the toolkit grows.
          </p>
        </div>
        <a href="/tools/" class="text-sm font-semibold text-slate-900 hover:underline">View all tools</a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((tool) => (
          <a
            href={tool.href}
            class="group relative isolate flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-slate-300 hover:shadow-xl hover:shadow-slate-900/5"
          >
            <!-- Background decoration -->
            <div class={`pointer-events-none absolute -right-8 -top-8 -z-10 h-36 w-36 rounded-full opacity-40 blur-2xl transition-opacity duration-300 group-hover:opacity-100 ${toneFor(tool.badgeColor).glow}`}></div>
            <svg
              class={`pointer-events-none absolute -right-3 -top-3 -z-10 h-24 w-24 rotate-12 opacity-[0.09] transition duration-300 ease-out group-hover:rotate-0 group-hover:opacity-[0.16] ${toneFor(tool.badgeColor).mark}`}
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
            >
              <path d={tool.iconPath} />
            </svg>
            <div class="pointer-events-none absolute bottom-0 right-0 -z-10 h-28 w-40 opacity-70" style={dotGrid}></div>

            <span class={`inline-flex h-11 w-11 items-center justify-center rounded-xl ring-1 transition-transform duration-300 group-hover:scale-110 ${toneFor(tool.badgeColor).tile}`}>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={tool.iconPath} />
              </svg>
            </span>
            <h3 class="mt-5 text-lg font-semibold text-slate-900 transition-colors group-hover:text-brand-600">{tool.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{tool.description}</p>
            <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-slate-900 transition-all group-hover:gap-2">
              Try it free
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FeatureShowcase />

  <RecentTools />

  <WhyChooseUs />

  <UseCases />

  <HomeFaq />

  <!-- Final call to action -->
  <section class="mx-auto max-w-6xl px-4 pb-24 pt-8">
    <div class="relative isolate overflow-hidden rounded-3xl bg-slate-900 px-8 py-14 text-center sm:px-16">
      <div class="pointer-events-none absolute left-1/2 top-0 -z-10 h-64 w-[640px] -translate-x-1/2 rounded-full bg-gradient-to-r from-purple-500/40 via-indigo-500/30 to-cyan-500/40 blur-3xl"></div>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Ready to try a tool?</h2>
      <p class="mx-auto mt-3 max-w-xl text-slate-300">Pick a tool and get going in seconds. No signup, no upload, no catch.</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/svg-tools/svg-editor/"
          class="inline-flex items-center rounded-xl bg-white px-6 py-3 text-sm font-semibold text-slate-900 shadow-lg transition hover:bg-slate-100"
        >
          Open SVG Editor
        </a>
        <a
          href="/tools/"
          class="inline-flex items-center rounded-xl border border-white/20 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
        >
          Explore all tools
        </a>
      </div>
    </div>
  </section>

</MainLayout>